class Renderer(object):
    def __init__(self, w, h, stage):
        self.scene = SCNScene.scene()
        self.root = self.scene.rootNode()
        v = SCNView.alloc().initWithFrame_options_(
            CGRect(CGPoint(0, 0), CGSize(w, h)), None)
        v.setScene_(self.scene)
        v.setAntialiasingMode_(2 if QUALITY >= 2 else (1 if QUALITY else 0))
        v.setPreferredFramesPerSecond_(60)
        v.setRendersContinuously_(True)
        v.setPlaying_(True)
        v.setUserInteractionEnabled_(False)
        v.setAutoresizingMask_(18)
        self.view = v
        self.mats = {}
        self.geos = {}
        self.fdata = {}
        self.bursts = []
        self.gnodes = {}
        self.gen = -1
        self.world_id = None
        self.mesh_ok = True
        self.env = None
        self.stage_key = None
        self.fire_lights = []
        self.fov = None
        self.head_hidden = False
        self.build_camera()
        self.build_effects()
        self.splats = [self.mat('splat%d' % k, rough=0.22, img=tex_splat(k + 1),
                                depth=False) for k in range(4)]
        self.build_stage(stage)
        v.setPointOfView_(self.cam_node)

    # ---------- 材質・ノード ----------
    def mat(self, key, rgb=(1, 1, 1), rough=0.8, metal=0.0, emit=None,
            const=False, img=None, depth=True):
        if key in self.mats:
            return self.mats[key]
        m = SCNMaterial.material()
        m.setLightingModelName_('constant' if const else 'physicallyBased')
        m.diffuse().setContents_(ObjCInstance(img) if img is not None else color(rgb))
        if not const:
            m.roughness().setContents_(ns(rough))
            m.metalness().setContents_(ns(metal))
        if emit is not None:
            m.emission().setContents_(color(emit))
        if not depth:
            opt(m.setWritesToDepthBuffer_, False)
        self.mats[key] = m
        return m

    def node(self, geo, m, parent=None, pos=None):
        if m is not None:
            geo.setFirstMaterial_(m)
        n = SCNNode.nodeWithGeometry_(geo)
        if pos is not None:
            set_pos(n, pos)
        (parent or self.root).addChildNode_(n)
        return n

    def en(self, geo, m, pos=None):
        return self.node(geo, m, parent=self.env, pos=pos)

    def mesh_node(self, key, build, mats, parent=None, pos=None):
        """独自メッシュのノード(同形状はキャッシュして共有)"""
        g = self.geos.get(key)
        if g is None:
            v, groups = build()
            g = make_geometry(v, groups)
            g.setMaterials_(mats)
            self.geos[key] = g
        n = SCNNode.nodeWithGeometry_(g)
        if pos is not None:
            set_pos(n, pos)
        (parent or self.root).addChildNode_(n)
        return n

    def mesh_fail(self, e):
        if self.mesh_ok:
            MESH_ERR.append('mesh: %r' % (e,))
        self.mesh_ok = False

    # ---------- カメラ ----------
    def build_camera(self):
        cam = SCNCamera.camera()
        opt(cam.setProjectionDirection_, 0)
        cam.setZNear_(0.03)
        cam.setZFar_(260.0)
        if QUALITY >= 1:
            opt(cam.setWantsHDR_, True)
            opt(cam.setWantsExposureAdaptation_, False)
            opt(cam.setBloomIntensity_, 0.45)
            opt(cam.setBloomThreshold_, 0.85)
            opt(cam.setBloomBlurRadius_, 6.0)
            opt(cam.setVignettingIntensity_, 0.55)
            opt(cam.setVignettingPower_, 1.1)
        if QUALITY >= 2:
            opt(cam.setScreenSpaceAmbientOcclusionIntensity_, 0.7)
            opt(cam.setScreenSpaceAmbientOcclusionRadius_, 0.25)
            opt(cam.setMotionBlurIntensity_, 0.25)
        self.cam = cam
        self.cam_node = SCNNode.node()
        self.cam_node.setCamera_(cam)
        self.root.addChildNode_(self.cam_node)

    def dir_light(self, rgb, inten, direction, shadow):
        l = SCNLight.light()
        l.setType_('directional')
        l.setColor_(color(rgb))
        l.setIntensity_(inten)
        if shadow and QUALITY >= 1:
            l.setCastsShadow_(True)
            opt(l.setShadowMode_, 0)
            opt(l.setShadowSampleCount_, 8 if QUALITY >= 2 else 2)
            opt(l.setShadowRadius_, 3.0)
            opt(l.setShadowColor_, color((0.08, 0.05, 0.10), 0.72))
            opt(l.setOrthographicScale_, 7.0)
            opt(l.setAutomaticallyAdjustsShadowProjection_, True)
            opt(l.setMaximumShadowDistance_, 20.0)
        n = SCNNode.node()
        n.setLight_(l)
        Z = mul(norm(direction), -1.0)
        X = norm(cross(UP, Z))
        set_rot(n, quat_from_basis(X, cross(Z, X), Z))
        self.env.addChildNode_(n)

    # ---------- ステージ ----------
    def build_stage(self, st):
        if self.env is not None:
            self.env.removeFromParentNode()
        self.env = SCNNode.node()
        self.root.addChildNode_(self.env)
        self.fire_lights = []
        self.stage_key = st['key']
        k = st['key']

        sky = tex_sky(st['sky'], st['cloud'])
        m = self.mat('sky_' + k, const=True, img=sky)
        opt(m.setCullMode_, 1)
        g = SCNSphere.sphereWithRadius_(110.0)
        opt(g.setSegmentCount_, 48)
        self.en(g, m)
        env = self.scene.lightingEnvironment()
        env.setContents_(ObjCInstance(sky))
        opt(env.setIntensity_, 1.3)
        self.scene.setFogStartDistance_(st['fog_d'][0])
        self.scene.setFogEndDistance_(st['fog_d'][1])
        self.scene.setFogColor_(color(st['fog']))
        self.view.setBackgroundColor_(color(st['fog']))

        sun = st['sun']
        self.dir_light(sun[0], sun[1], sun[2], True)
        fd = norm((0.7, -0.3, -0.5))
        self.dir_light(st['fill'][0], st['fill'][1], fd, False)
        amb = SCNLight.light()
        amb.setType_('ambient')
        amb.setColor_(color(st['amb'][0]))
        amb.setIntensity_(st['amb'][1])
        n = SCNNode.node()
        n.setLight_(amb)
        self.env.addChildNode_(n)

        fl = SCNPlane.planeWithWidth_height_(44.0, 44.0)
        n = self.en(fl, self.mat('ground_' + st['ground'], rough=0.97,
                                 img=tex_ground(st['ground'])))
        set_euler(n, -math.pi * 0.5, 0.0, 0.0)
        ring = SCNTorus.torusWithRingRadius_pipeRadius_(ARENA_R + 0.15, 0.045)
        self.en(ring, self.mat('rope', (0.78, 0.68, 0.45), 0.9), pos=(0, 0.04, 0))

        if st['disc']:
            sd = norm(mul(st['sun'][2], -1.0))
            dm = self.mat('disc_' + st['disc'], const=True, img=tex_disc(st['disc']))
            opt(dm.setBlendMode_, 1)
            opt(dm.setWritesToDepthBuffer_, False)
            size = 34.0 if st['disc'] == 'sun' else 22.0
            n = self.en(SCNPlane.planeWithWidth_height_(size, size), dm,
                        pos=(sd[0] * 90.0, max(12.0, sd[1] * 90.0), sd[2] * 90.0))
            n.setConstraints_([SCNBillboardConstraint.billboardConstraint()])

        mm = self.mat('mtn_' + k, st['mtn'], 1.0)
        for x, z, r, h in ((60, -70, 34, 24), (-40, -85, 40, 20),
                           (-75, 20, 30, 18), (30, 80, 36, 22)):
            self.en(SCNCone.coneWithTopRadius_bottomRadius_height_(0, r, h), mm,
                    pos=(x, h * 0.5 - 1.0, z))

        getattr(self, 'scene_' + st['scenery'])()
        self.particles(st['particles'])

