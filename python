def opt(fn, *args):
    try:
        fn(*args)
    except Exception:
        pass


def nsdata(b):
    """bytes → NSData。ポインタ引数を使わない方式から順に試す"""
    n = len(b)
    try:
        d = NSMutableData.dataWithLength_(n)
        ptr = d.mutableBytes()
        if isinstance(ptr, int) and ptr:
            ctypes.memmove(ptr, b, n)
            return d
    except Exception as e:
        MESH_ERR.append('mutable: %r' % (e,))
    try:
        d = ns(b)
        if d is not None and not isinstance(d, (bytes, bytearray)):
            return d
    except Exception as e:
        MESH_ERR.append('ns: %r' % (e,))
    buf = ctypes.create_string_buffer(b, n)
    ptr = NSData.dataWithBytes_length_(ctypes.addressof(buf), n,
                                       restype=ctypes.c_void_p,
                                       argtypes=[ctypes.c_void_p, ctypes.c_ulong])
    return ObjCInstance(ptr)


def _semantic(sym, fallback):
    try:
        return ObjCInstance(ctypes.c_void_p.in_dll(objc_util.c, sym).value)
    except Exception:
        return ns(fallback)


SEM_V = _semantic('SCNGeometrySourceSemanticVertex', 'kGeometrySourceSemanticVertex')
SEM_N = _semantic('SCNGeometrySourceSemanticNormal', 'kGeometrySourceSemanticNormal')


def _sources_by_data(verts, normals):
    n = len(verts)
    fv = [c for v in verts for c in v]
    fn = [c for v in normals for c in v]
    dv = nsdata(struct.pack('<%df' % len(fv), *fv))
    dn = nsdata(struct.pack('<%df' % len(fn), *fn))
    mk = SCNGeometrySource.geometrySourceWithData_semantic_vectorCount_floatComponents_componentsPerVector_bytesPerComponent_dataOffset_dataStride_
    return [mk(dv, SEM_V, n, True, 3, 4, 0, 12), mk(dn, SEM_N, n, True, 3, 4, 0, 12)]


def _sources_by_vectors(verts, normals):
    n = len(verts)
    va = (V3 * n)(*[V3(*v) for v in verts])
    na = (V3 * n)(*[V3(*v) for v in normals])
    sv = SCNGeometrySource.geometrySourceWithVertices_count_(
        ctypes.addressof(va), n, restype=ctypes.c_void_p,
        argtypes=[ctypes.c_void_p, ctypes.c_long])
    sn = SCNGeometrySource.geometrySourceWithNormals_count_(
        ctypes.addressof(na), n, restype=ctypes.c_void_p,
        argtypes=[ctypes.c_void_p, ctypes.c_long])
    return [ObjCInstance(sv), ObjCInstance(sn)]


def make_geometry(verts, groups, normals=None):
    """頂点・三角形 → SCNGeometry(三角形グループごとに材質を割り当てられる)"""
    if normals is None:
        normals = vnormals(verts, groups)
    n = len(verts)
    try:
        srcs = _sources_by_data(verts, normals)
    except Exception as e:
        MESH_ERR.append('source(data): %r' % (e,))
        srcs = _sources_by_vectors(verts, normals)
    els = []
    fmt, bpi = ('H', 2) if n < 65535 else ('I', 4)
    for g in groups:
        if not g:
            g = [(0, 0, 0)]
        flat = [i for t in g for i in t]
        di = nsdata(struct.pack('<%d%s' % (len(flat), fmt), *flat))
        els.append(SCNGeometryElement.geometryElementWithData_primitiveType_primitiveCount_bytesPerIndex_(
            di, 0, len(g), bpi))
    geo = SCNGeometry.geometryWithSources_elements_(srcs, els)
    if geo is None:
        raise ValueError('geometryWithSources が nil')
    return geo


