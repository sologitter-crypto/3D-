def prof_eval(keys, u):
    """輪郭をキャットマル-ロム補間 → (rx, rz, cx, cz)"""
    n = len(keys)
    if u <= keys[0][0]:
        return keys[0][1:]
    if u >= keys[-1][0]:
        return keys[-1][1:]
    k = 0
    while k < n - 2 and u > keys[k + 1][0]:
        k += 1
    s = (u - keys[k][0]) / (keys[k + 1][0] - keys[k][0])
    p0, p1 = keys[max(0, k - 1)], keys[k]
    p2, p3 = keys[k + 1], keys[min(n - 1, k + 2)]
    out = []
    for c in range(1, 5):
        a, b, cc, d = p0[c], p1[c], p2[c], p3[c]
        out.append(0.5 * (2 * b + (-a + cc) * s + (2 * a - 5 * b + 4 * cc - d) * s * s
                          + (-a + 3 * b - 3 * cc + d) * s * s * s))
    out[0] = max(out[0], 0.004)
    out[1] = max(out[1], 0.004)
    return tuple(out)


def prof_range(name):
    k = PROFILES[name]
    return k[0][0], k[-1][0]


def loft(keys, L0, u0, u1, ys, cap0, cap1, M=18, grow=0.0):
    """断面輪郭から筒状メッシュを作る。
    cap: 'round' = 丸い端, 'cut' = 切断面(肉と骨), None = 開口
    戻り値 (頂点, [本体, 肉, 骨] の三角形リスト)"""
    N = max(4, int((u1 - u0) * L0 / 0.02) + 1)
    seq = []

    def Y(u):
        return (u - 0.5) * L0 - ys

    def P(u):
        rx, rz, cx, cz = prof_eval(keys, u)
        return rx + grow, rz + grow, cx, cz
    K = 4
    r0 = P(u0)
    if cap0 == 'round':
        cl = min(r0[0], r0[1]) * 0.9
        seq.append(('pole', Y(u0) - cl, 0, 0, r0[2], r0[3]))
        for k in range(1, K):
            a = (K - k) / float(K) * math.pi * 0.5
            seq.append(('ring', Y(u0) - math.sin(a) * cl, r0[0] * math.cos(a),
                        r0[1] * math.cos(a), r0[2], r0[3]))
    for k in range(N + 1):
        u = u0 + (u1 - u0) * k / float(N)
        rx, rz, cx, cz = P(u)
        seq.append(('ring', Y(u), rx, rz, cx, cz))
    r1 = P(u1)
    if cap1 == 'round':
        cl = min(r1[0], r1[1]) * 0.9
        for k in range(1, K):
            a = k / float(K) * math.pi * 0.5
            seq.append(('ring', Y(u1) + math.sin(a) * cl, r1[0] * math.cos(a),
                        r1[1] * math.cos(a), r1[2], r1[3]))
        seq.append(('pole', Y(u1) + cl, 0, 0, r1[2], r1[3]))

    cs = [(math.cos(2 * math.pi * m / M), math.sin(2 * math.pi * m / M))
          for m in range(M)]
    verts, main, flesh, bone = [], [], [], []
    idx = []
    for e in seq:
        idx.append(len(verts))
        if e[0] == 'pole':
            verts.append((e[4], e[1], e[5]))
        else:
            for c, s in cs:
                verts.append((e[4] + e[2] * c, e[1], e[5] + e[3] * s))
    for s_ in range(len(seq) - 1):
        A, B = seq[s_], seq[s_ + 1]
        ia, ib = idx[s_], idx[s_ + 1]
        for m in range(M):
            m1 = (m + 1) % M
            if A[0] == 'pole':
                main.append((ia, ib + m, ib + m1))
            elif B[0] == 'pole':
                main.append((ia + m, ib, ia + m1))
            else:
                main.append((ia + m, ib + m, ib + m1))
                main.append((ia + m, ib + m1, ia + m1))
    for end, cap, e in ((0, cap0, seq[0]), (1, cap1, seq[-1])):
        if cap != 'cut' or e[0] != 'ring':
            continue
        y, rx, rz, cx, cz = e[1], e[2], e[3], e[4], e[5]
        o = len(verts)
        for sc in (1.0, 0.34, 0.30):
            for c, s in cs:
                verts.append((cx + rx * sc * c, y, cz + rz * sc * s))
        ctr = len(verts)
        verts.append((cx, y, cz))
        for m in range(M):
            m1 = (m + 1) % M
            O0, O1 = o + m, o + m1
            I0, I1 = o + M + m, o + M + m1
            B0, B1 = o + 2 * M + m, o + 2 * M + m1
            if end == 1:        # 法線 +Y
                flesh.append((I0, O1, O0))
                flesh.append((I0, I1, O1))
                bone.append((ctr, B1, B0))
            else:               # 法線 -Y
                flesh.append((I0, O0, O1))
                flesh.append((I0, O1, I1))
                bone.append((ctr, B0, B1))
    return verts, [main, flesh, bone]


def vnormals(verts, groups):
    acc = [[0.0, 0.0, 0.0] for _ in verts]
    for g in groups:
        for a, b, c in g:
            va, vb, vc = verts[a], verts[b], verts[c]
            n = cross(sub(vb, va), sub(vc, va))
            for i in (a, b, c):
                t = acc[i]
                t[0] += n[0]
                t[1] += n[1]
                t[2] += n[2]
    out = []
    for t in acc:
        n = norm(tuple(t))
        out.append(n if n != (0.0, 0.0, 0.0) else (0.0, 1.0, 0.0))
    return out


# ---------- 頭部(鼻・眉弓・眼窩・頬骨・顎・唇の起伏を持つ変形球) ----------
HEAD_C = (0.0, 0.012, 0.0)
_FEAT = []


def _feat():
    if _FEAT:
        return _FEAT
    F = []
    F.append((norm((0, -0.08, -1)), 0.14, 0.021))       # 鼻
    F.append((norm((0, 0.03, -1)), 0.10, 0.006))        # 鼻根
    F.append((norm((0, 0.30, -1)), 0.24, 0.006))        # 眉弓
    for sx in (-1, 1):
        F.append((norm((0.36 * sx, 0.14, -0.92)), 0.12, -0.010))   # 眼窩
        F.append((norm((0.56 * sx, -0.12, -0.82)), 0.17, 0.005))   # 頬骨
        F.append((norm((0.60 * sx, -0.55, -0.58)), 0.20, 0.004))   # 下顎角
    F.append((norm((0, -0.70, -0.72)), 0.15, 0.008))    # 顎先
    F.append((norm((0, -0.38, -0.93)), 0.07, 0.0035))   # 上唇
    F.append((norm((0, -0.48, -0.88)), 0.07, 0.003))    # 下唇
    F.append((norm((0, -0.43, -0.90)), 0.05, -0.003))   # 口裂
    _FEAT.extend(F)
    return F


def head_point(d):
    x, y, z = d
    px, py, pz = 0.077 * x, 0.106 * y, 0.097 * z
    if y < -0.15:
        s = min(1.0, (-y - 0.15) / 0.6)
        px *= 1.0 - 0.28 * s
        if z > 0:
            pz *= 1.0 - 0.32 * s
    bump = 0.0
    for c, w, amp in _feat():
        a2 = 2.0 * (1.0 - dot(d, c))
        if a2 < 9.0 * w * w:
            bump += amp * math.exp(-a2 / (2.0 * w * w))
    return (px + x * bump + HEAD_C[0], py + y * bump + HEAD_C[1],
            pz + z * bump + HEAD_C[2])


def has_hair(d):
    x, y, z = d
    return y > (0.10 + 0.32 * (-z) if z < 0 else 0.10 - 0.55 * z)


def sphere_mesh(fn, keep=None, LAT=30, LON=44):
    """単位方向 d → 位置 fn(d) の球面メッシュ。keep(d) で部分だけ残す"""
    verts, dirs, tris = [], [], []
    grid = []
    for i in range(LAT + 1):
        th = math.pi * i / LAT
        row = []
        for j in range(LON):
            ph = 2 * math.pi * j / LON
            d = (math.sin(th) * math.cos(ph), math.cos(th), math.sin(th) * math.sin(ph))
            row.append(len(verts))
            verts.append(fn(d))
            dirs.append(d)
        grid.append(row)
    for i in range(LAT):
        for j in range(LON):
            j1 = (j + 1) % LON
            a, b, c, e = grid[i][j], grid[i + 1][j], grid[i + 1][j1], grid[i][j1]
            for t in ((a, e, c), (a, c, b)):
                if keep is None or all(keep(dirs[v]) for v in t):
                    tris.append(t)
    orient_out(verts, tris, lambda p: HEAD_C)
    if keep is not None:
        used = sorted(set(v for t in tris for v in t))
        remap = dict((v, k) for k, v in enumerate(used))
        verts = [verts[v] for v in used]
        tris = [(remap[a], remap[b], remap[c]) for a, b, c in tris]
    return verts, tris


def orient_out(verts, tris, center_fn):
    for k, (a, b, c) in enumerate(tris):
        va, vb, vc = verts[a], verts[b], verts[c]
        n = cross(sub(vb, va), sub(vc, va))
        cen = mul(add(add(va, vb), vc), 1.0 / 3.0)
        if dot(n, sub(cen, center_fn(cen))) < 0:
            tris[k] = (a, c, b)


def head_mesh():
    return sphere_mesh(head_point)


def hair_mesh():
    return sphere_mesh(lambda d: add(head_point(d), mul(d, 0.0055)), keep=has_hair)


# ---------- 刀身(反りと切先・鎬造りの断面・面ごとの陰影) ----------
def blade_mesh():
    L, N, sori = BLADE, 18, 0.018

    def xo(y):
        return -sori * (y / L) ** 2

    def section(y, k):
        w = (0.031 - 0.006 * (y / L)) * k
        t = 0.0072 - 0.0022 * (y / L)
        x = xo(y)
        return [(x + 0.5 * w, y, 0.0), (x + 0.08 * w, y, 0.5 * t),
                (x - 0.5 * w, y, 0.32 * t), (x - 0.5 * w, y, -0.32 * t),
                (x + 0.08 * w, y, -0.5 * t)]
    rings = [section(L * 0.93 * k / N, 1.0) for k in range(N + 1)]
    rings.append(section(L * 0.975, 0.62))
    tip = (xo(L) - 0.004, L, 0.0)
    verts, tris = [], []

    def tri(a, b, c):
        o = len(verts)
        verts.extend([a, b, c])
        tris.append((o, o + 1, o + 2))
    for r in range(len(rings) - 1):
        A, B = rings[r], rings[r + 1]
        for m in range(5):
            m1 = (m + 1) % 5
            tri(A[m], B[m], B[m1])
            tri(A[m], B[m1], A[m1])
    for m in range(5):
        tri(rings[-1][m], tip, rings[-1][(m + 1) % 5])
    orient_out(verts, tris, lambda p: (xo(min(p[1], L)), p[1], 0.0))
    return verts, tris


# =====================================================================
# 質点・制御
# =====================================================================
class Pt(object):
    __slots__ = ('x', 'y', 'z', 'px', 'py', 'pz', 'fx', 'fy', 'fz',
                 'm', 'im', 'r')

    def __init__(self, pos, m, r):
        self.x, self.y, self.z = pos
        self.px, self.py, self.pz = pos
        self.fx = self.fy = self.fz = 0.0
        self.m = m
        self.im = 1.0 / m
        self.r = r

    def pos(self):
        return (self.x, self.y, self.z)

    def vel(self, idt):
        return ((self.x - self.px) * idt, (self.y - self.py) * idt,
                (self.z - self.pz) * idt)


def pull(q, tx, ty, tz, ka, kd, idt, ax=True, ay=True, az=True):
    m = q.m
    if ax:
        q.fx += m * (ka * (tx - q.x) - kd * (q.x - q.px) * idt)
    if ay:
        q.fy += m * (ka * (ty - q.y) - kd * (q.y - q.py) * idt)
    if az:
        q.fz += m * (ka * (tz - q.z) - kd * (q.z - q.pz) * idt)


def pull_rel(q, base, t, ka, kd, idt, react):
    me = 1.0 / (q.im + base.im)
    fx = me * (ka * (t[0] - q.x) - kd * ((q.x - q.px) - (base.x - base.px)) * idt)
    fy = me * (ka * (t[1] - q.y) - kd * ((q.y - q.py) - (base.y - base.py)) * idt)
    fz = me * (ka * (t[2] - q.z) - kd * ((q.z - q.pz) - (base.z - base.pz)) * idt)
    q.fx += fx
    q.fy += fy
    q.fz += fz
    base.fx -= fx * react
    base.fy -= fy * react
    base.fz -= fz * react


def ik(a, b, l1, l2, bend):
    d = sub(b, a)
    L = clamp(length(d), 1e-4, l1 + l2 - 1e-4)
    u = norm(d)
    x = (l1 * l1 - l2 * l2 + L * L) / (2.0 * L)
    h = math.sqrt(max(0.0, l1 * l1 - x * x))
    perp = norm(sub(bend, mul(u, dot(bend, u))))
    return add(add(a, mul(u, x)), mul(perp, h))


class Seg(object):
    __slots__ = ('i', 'j', 'r', 'mat', 'part', 'sever', 'prof', 'L0', 'u0', 'u1',
                 'ys', 'cap0', 'cap1', 'dead', 'node', 'key', 'zref', 'frame',
                 'marks', 'mrk_n')


