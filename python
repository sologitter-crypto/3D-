def draw_stage_art(st, x, y, w, h):
    top, mid, hor, low = st['sky']
    N = 24
    for i in range(N):
        v = i / float(N - 1)
        c = lerp(top, mid, v / 0.6) if v < 0.6 else lerp(mid, hor, (v - 0.6) / 0.4)
        ui.set_color(c)
        ui.Path.rect(x, y + h * 0.7 * i / N, w, h * 0.7 / N + 1).fill()
    ui.set_color(st['mtn'])
    p = ui.Path()
    p.move_to(x, y + h * 0.7)
    p.line_to(x + w * 0.35, y + h * 0.45)
    p.line_to(x + w * 0.6, y + h * 0.62)
    p.line_to(x + w * 0.8, y + h * 0.5)
    p.line_to(x + w, y + h * 0.66)
    p.line_to(x + w, y + h * 0.7)
    p.close()
    p.fill()
    if st['disc']:
        ui.set_color((1.0, 0.92, 0.8, 0.95) if st['disc'] == 'sun' else (0.92, 0.95, 1.0, 0.95))
        ui.Path.oval(x + w * 0.66, y + h * 0.16, w * 0.16, w * 0.16).fill()
    ui.set_color(lerp(low, (0, 0, 0), 0.3))
    ui.Path.rect(x, y + h * 0.7, w, h * 0.3).fill()
    motif = st['scenery']
    if motif == 'temple':
        ui.set_color((0.70, 0.12, 0.08))
        ui.Path.rect(x + w * 0.2, y + h * 0.42, w * 0.03, h * 0.3).fill()
        ui.Path.rect(x + w * 0.42, y + h * 0.42, w * 0.03, h * 0.3).fill()
        ui.Path.rect(x + w * 0.15, y + h * 0.4, w * 0.35, h * 0.03).fill()
    elif motif == 'bamboo':
        ui.set_color((0.25, 0.42, 0.22))
        for k in range(9):
            ui.Path.rect(x + w * (0.05 + k * 0.11), y, w * 0.022, h * 0.72).fill()
    elif motif == 'castle':
        ui.set_color((0.92, 0.92, 0.9))
        ui.Path.rect(x + w * 0.2, y + h * 0.45, w * 0.25, h * 0.25).fill()
        ui.set_color((0.25, 0.27, 0.3))
        ui.Path.rect(x + w * 0.16, y + h * 0.43, w * 0.33, h * 0.04).fill()
    else:
        ui.set_color((0.08, 0.05, 0.05))
        ui.Path.rect(x + w * 0.55, y + h * 0.35, w * 0.3, h * 0.36).fill()
        ui.set_color((1.0, 0.45, 0.1, 0.9))
        for k in range(4):
            ui.Path.oval(x + w * (0.56 + k * 0.07), y + h * 0.28, w * 0.07, h * 0.12).fill()


class Menu(ui.View):
    def __init__(self, game, frame):
        ui.View.__init__(self, frame=frame)
        self.game = game
        self.flex = 'WH'
        self.background_color = (0, 0, 0, 0)
        self.btns = []
        for k in range(len(STAGES)):
            b = ui.Button(title='')
            b.background_color = (0, 0, 0, 0)
            b.action = (lambda kk: (lambda s: game.start_stage(kk)))(k)
            self.add_subview(b)
            self.btns.append(b)
        self.layout()

    def cards(self):
        W, H = self.width, self.height
        n = len(STAGES)
        gap = 14
        cw = (W - 48 - gap * (n - 1)) / float(n)
        ch = min(H * 0.58, cw * 1.35)
        y0 = H * 0.25
        return [(24 + k * (cw + gap), y0, cw, ch) for k in range(n)]

    def layout(self):
        for b, r in zip(self.btns, self.cards()):
            b.frame = r

    def draw(self):
        g = self.game
        W, H = self.width, self.height
        ui.set_color((0.03, 0.02, 0.03, 0.78))
        ui.Path.rect(0, 0, W, H).fill()
        draw_text('斬 鉄  3D', (0, H * 0.04, W, 40), 32, (1, 0.95, 0.85), ui.ALIGN_CENTER)
        draw_text('― 演舞場を選べ ―', (0, H * 0.04 + 42, W, 22), 15,
                  (0.9, 0.85, 0.78), ui.ALIGN_CENTER)
        for k, (x, y, cw, ch) in enumerate(self.cards()):
            st = STAGES[k]
            ok = g.unlocked(k)
            with ui.GState():
                clip = ui.Path.rounded_rect(x, y, cw, ch * 0.62, 10)
                clip.add_clip()
                draw_stage_art(st, x, y, cw, ch * 0.62)
                if not ok:
                    ui.set_color((0, 0, 0, 0.6))
                    ui.Path.rect(x, y, cw, ch).fill()
            ui.set_color((0.10, 0.07, 0.08, 0.85))
            ui.Path.rounded_rect(x, y + ch * 0.62, cw, ch * 0.38, 10).fill()
            border = ui.Path.rounded_rect(x, y, cw, ch, 10)
            border.line_width = 2
            ui.set_color((0.95, 0.78, 0.35, 0.95) if g.cleared[k]
                         else ((1, 1, 1, 0.35) if ok else (1, 1, 1, 0.12)))
            border.stroke()
            ty = y + ch * 0.64
            dim = 1.0 if ok else 0.45
            draw_text('第%s景' % '一二三四五六'[k], (x, ty, cw, 18), 12,
                      (0.9, 0.8, 0.6, dim), ui.ALIGN_CENTER)
            draw_text(st['name'], (x, ty + 18, cw, 24), 17, (1, 0.96, 0.9, dim),
                      ui.ALIGN_CENTER)
            draw_text(st['desc'], (x, ty + 42, cw, 18), 11, (0.85, 0.82, 0.78, dim),
                      ui.ALIGN_CENTER)
            stars = int(round(st['level'] * 2.8 - 1.1))
            draw_text('★' * stars + '☆' * (4 - stars), (x, ty + 60, cw, 18), 12,
