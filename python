class Result(ui.View):
    def __init__(self, game, frame, win, world):
        ui.View.__init__(self, frame=frame)
        self.game = game
        self.win = win
        self.flex = 'WH'
        self.background_color = (0, 0, 0, 0)
        self.stage = world.stage
        self.st = world.st
        s = world.stats
        self.lines = [
            ('試合時間', '%d:%02d' % (int(s['time']) // 60, int(s['time']) % 60)),
            ('断った部位', '%d' % s['sever']),
            ('与えた傷', '%d' % s['wound']),
            ('深手', '%d' % s['deep']),
            ('勝ち越し', '%d - %d' % (world.wins[0], world.wins[1])),
        ]
        if win:
            hp = sum(s['hp']) / max(1, len(s['hp']))
            score = 45 + s['sever'] * 7 + s['deep'] * 3 + hp * 0.45 - s['time'] / 8.0 \
                - world.wins[1] * 12
            self.grade = '優' if score >= 85 else ('良' if score >= 65 else '可')
            self.lines.append(('残り体力', '%d' % hp))
        else:
            self.grade = None
        opts = []
        if win and self.stage + 1 < len(STAGES):
            opts.append(('次の景へ', lambda s: game.start_stage(self.stage + 1)))
        opts.append(('もう一度' if win else '再挑戦', lambda s: game.start_stage(self.stage)))
        opts.append(('景を選ぶ', lambda s: game.show_menu()))
        self.btns = []
        for title, act in opts:
            b = ui.Button(title=title)
            b.font = (FONT, 16)
            b.tint_color = (1, 0.96, 0.88)
            b.background_color = (0.55, 0.12, 0.10, 0.9) if not self.btns \
                else (0.15, 0.10, 0.10, 0.85)
            b.corner_radius = 22
            b.action = act
            self.add_subview(b)
            self.btns.append(b)
        self.layout()

    def layout(self):
        W, H = self.width, self.height
        n = len(self.btns)
        bw, gap = 150, 16
        x0 = (W - (bw * n + gap * (n - 1))) * 0.5
        for k, b in enumerate(self.btns):
            b.frame = (x0 + k * (bw + gap), H * 0.80, bw, 44)

    def draw(self):
        W, H = self.width, self.height
        ui.set_color((0.02, 0.01, 0.02, 0.72))
        ui.Path.rect(0, 0, W, H).fill()
        last = self.win and self.stage + 1 >= len(STAGES)
        if self.win:
            title = '天晴れ' if not last else '天下無双'
            sub_ = '%s 制覇' % self.st['name'] if not last else '全ての景を制覇した'
            col = (1.0, 0.85, 0.45)
        else:
            title, sub_, col = '敗北', '%s にて散る' % self.st['name'], (0.9, 0.45, 0.4)
        draw_text(title, (0, H * 0.08, W, 60), 48, col, ui.ALIGN_CENTER)
        draw_text(sub_, (0, H * 0.08 + 62, W, 26), 18, (1, 0.95, 0.88), ui.ALIGN_CENTER)
        x0, y = W * 0.5 - 150, H * 0.36
        for k, v in self.lines:
            draw_text(k, (x0, y, 160, 24), 16, (0.85, 0.82, 0.78))
            draw_text(v, (x0 + 160, y, 140, 24), 16, (1, 0.97, 0.9), ui.ALIGN_RIGHT)
            y += 26
        if self.grade:
            draw_text('評価', (W * 0.5 + 170, H * 0.36, 80, 22), 14, (0.9, 0.85, 0.75),
                      ui.ALIGN_CENTER)
            draw_text(self.grade, (W * 0.5 + 170, H * 0.36 + 22, 80, 70), 56,
                      (1.0, 0.8, 0.35), ui.ALIGN_CENTER)


# =====================================================================
# 本体
# =====================================================================
class GameView(ui.View):
    def __init__(self, *a, **kw):
        ui.View.__init__(self, *a, **kw)
        w, h = ui.get_screen_size()
        if w < h:
            w, h = h, w
        self.frame = (0, 0, w, h)
        self.background_color = 'black'
        self.multitouch_enabled = True      # 移動と剣を同時に操作する
        self.mode = 'menu'
        self.stage = 0
        self.cleared = [False] * len(STAGES)
        self.world = World(0)
        self.cam = Camera()
        self.rend = Renderer(w, h, STAGES[0])
        ObjCInstance(self).addSubview_(self.rend.view)
        self.hud = HUD(frame=(0, 0, w, h))
        self.hud.flex = 'WH'
        self.hud.background_color = (0, 0, 0, 0)
        self.hud.touch_enabled = False
        self.hud.game = self
        self.add_subview(self.hud)

        def btn(title, frame, action, size=16):
            b = ui.Button(title=title)
            b.frame = frame
            b.font = (FONT, size)
            b.tint_color = (1, 0.97, 0.9)
            b.background_color = (0.12, 0.06, 0.07, 0.55)
            b.corner_radius = frame[3] * 0.5
            b.action = action
            self.add_subview(b)
            return b

        self.jump_btn = btn('跳', (18, h * 0.40, 64, 64),
                            lambda s: self.world.player.do_jump(), 24)
        self.view_btn = btn('三人称', (0, 0, 76, 40), lambda s: self.toggle_view(), 13)
        self.menu_btn = btn('景', (0, 0, 44, 40), lambda s: self.show_menu(), 15)
        self.reset_btn = btn('仕切直し', (0, 0, 88, 40), lambda s: self.redo(), 13)
        self.quit_btn = btn('×', (0, 0, 40, 40), lambda s: self.close(), 20)
        self.game_btns = [self.jump_btn, self.view_btn, self.menu_btn, self.reset_btn]

        self.menu = Menu(self, (0, 0, w, h))
        self.add_subview(self.menu)
        self.result = None

        self.touches = {}
        self.joy = None
        self.drag = None
        self.trail = []
        self.last = time.perf_counter()
        self.acc = 0.0
        self.layout()
        self.set_mode_ui()
        self.update_interval = 1.0 / 60.0

    def layout(self):
        w, h = self.width, self.height
        self.rend.view.setFrame_(CGRect(CGPoint(0, 0), CGSize(w, h)))
        self.jump_btn.frame = (18, h * 0.40, 64, 64)
        x = w - 16
        for b in (self.quit_btn, self.reset_btn, self.menu_btn, self.view_btn):
            fw, fh = b.frame[2], b.frame[3]
            x -= fw
            b.frame = (x, 62, fw, fh)
            x -= 8

    # ---------- 画面の切り替え ----------
    def unlocked(self, k):
        return k == 0 or self.cleared[k - 1]

    def set_mode_ui(self):
        play = self.mode == 'play'
        for b in self.game_btns:
            b.hidden = not play
        self.menu.hidden = self.mode != 'menu'
        if self.mode == 'menu':
            self.menu.set_needs_display()

    def clear_input(self):
        self.touches.clear()
        self.joy = None
        self.drag = None
        self.trail = []

    def start_stage(self, k):
        if not self.unlocked(k):
            return
        if self.result is not None:
            self.remove_subview(self.result)
            self.result = None
        if self.rend.stage_key != STAGES[k]['key']:
            self.rend.build_stage(STAGES[k])
        self.stage = k
        self.world = World(k)
        self.mode = 'play'
        self.clear_input()
        self.set_mode_ui()

    def show_menu(self):
        if self.result is not None:
            self.remove_subview(self.result)
            self.result = None
        self.mode = 'menu'
        self.clear_input()
        self.set_mode_ui()

    def show_result(self):
        win = self.world.match == 'win'
        if win:
            self.cleared[self.stage] = True
        self.mode = 'result'
        self.clear_input()
        self.result = Result(self, (0, 0, self.width, self.height), win, self.world)
        self.add_subview(self.result)
        self.set_mode_ui()

    def redo(self):
        if self.mode == 'play':
            self.world.redo_round()
            self.clear_input()

    def toggle_view(self):
        if self.cam.mode == 'tps':
            self.cam.set_mode('fps')
            self.view_btn.title = '一人称'
        else:
            self.cam.set_mode('tps')
            self.view_btn.title = '三人称'

    # ---------- 入力 ----------
    def pad_map(self, x, y):
        """右側の操作面 → 画面全体。右半分だけで剣を全方向に振れる"""
        W, H = self.width, self.height
        x0 = W * PAD_X0 + 10
        u = clamp((x - x0) / max(1.0, W - 14 - x0), 0.0, 1.0)
        v = clamp((y - 40) / max(1.0, H - 60), 0.0, 1.0)
        return W * (0.03 + 0.94 * u), H * (0.05 + 0.90 * v)

    def touch_began(self, t):
        if self.mode != 'play':
            return
        x, y = t.location
        wd = self.world
        if wd.state == 'over' and wd.match is None and wd.over_t > 1.0:
            wd.next_round()
            self.clear_input()
            return
        if x < self.width * PAD_X0 and self.joy is None:
            self.touches[t.touch_id] = 'joy'
            self.joy = [x, y, x, y]
        elif x >= self.width * PAD_X0 and self.drag is None:
            self.touches[t.touch_id] = 'sword'
            now = time.perf_counter()
            self.drag = [x, y, now, x, y, 0.0]
            vx, vy = self.pad_map(x, y)
            self.trail = [(vx, vy, now)]

    def touch_moved(self, t):
        role = self.touches.get(t.touch_id)
        x, y = t.location
        if role == 'joy' and self.joy:
            self.joy[2], self.joy[3] = x, y
        elif role == 'sword' and self.drag:
            d = self.drag
            d[5] += math.hypot(x - d[3], y - d[4])
            d[3], d[4] = x, y
            vx, vy = self.pad_map(x, y)
            self.trail.append((vx, vy, time.perf_counter()))
            if len(self.trail) > 16:
                self.trail.pop(0)

    def touch_ended(self, t):
        role = self.touches.pop(t.touch_id, None)
        if role == 'joy':
            self.joy = None
        elif role == 'sword' and self.drag:
            d = self.drag
            if time.perf_counter() - d[2] < 0.2 and d[5] < 14:
                self.world.player.do_thrust()
            self.drag = None

    def touch_cancelled(self, t):
        self.touch_ended(t)

    def apply_input(self):
        P = self.world.player
        cam = self.cam
        if self.mode != 'play':
            P.mvx = P.mvz = 0.0
            P.T_goal = None
            return
        if self.joy:
            ox, oy, cx, cy = self.joy
            jx = clamp((cx - ox) / 56.0, -1.0, 1.0)
            jy = clamp(-(cy - oy) / 56.0, -1.0, 1.0)
            fw = norm((cam.fw[0], 0.0, cam.fw[2]))
            rt = norm((cam.right[0], 0.0, cam.right[2]))
            mx = rt[0] * jx + fw[0] * jy
            mz = rt[2] * jx + fw[2] * jy
            l = math.hypot(mx, mz)
            if l > 1.0:
                mx, mz = mx / l, mz / l
            if l < 0.15:
                mx = mz = 0.0
            P.mvx, P.mvz = mx, mz
        else:
            P.mvx = P.mvz = 0.0
        if self.drag and self.drag[5] > 6:
            vx, vy = self.pad_map(self.drag[3], self.drag[4])
            P.T_goal = cam.drag_target(P, vx, vy, self.width, self.height)
        else:
            P.T_goal = None

    # ---------- ループ ----------
    def update(self):
        now = time.perf_counter()
        el = min(now - self.last, 0.05)
        self.last = now
        wd = self.world
        if self.mode in ('play', 'result'):
            scale = 0.3 if wd.slowmo > 0 else 1.0
            if wd.slowmo > 0:
                wd.slowmo -= el
            self.acc += el * scale
            self.apply_input()
            n = 0
            while self.acc >= DT and n < 3:
                wd.step()
                self.acc -= DT
                n += 1
            if self.acc > DT * 3:
                self.acc = 0.0
            if self.mode == 'play' and wd.match and wd.over_t > 2.2:
                self.show_result()
        self.cam.update(wd, el)
        self.rend.sync(wd, self.cam)
        self.hud.set_needs_display()

    def will_close(self):
        self.update_interval = 0
        self.rend.view.setPlaying_(False)


def main():
    v = GameView()
    v.present('fullscreen', hide_title_bar=True, orientations=['landscape'])


if __name__ == '__main__':
    main()