class Camera(object):
    FOV_TPS = 55.0
    FOV_FPS = 72.0

    def __init__(self):
        self.pos = (-3.6, 1.85, 0.8)
        self.look = (0.0, 1.15, 0.0)
        self.fw = (1.0, 0.0, 0.0)
        self.right = (0.0, 0.0, 1.0)
        self.up = UP
        self.jitter = (0.0, 0.0, 0.0)
        self.set_mode('tps')

    def set_mode(self, mode):
        self.mode = mode
        self.fov = self.FOV_FPS if mode == 'fps' else self.FOV_TPS
        self.th = math.tan(math.radians(self.fov) * 0.5)

    def fps_active(self, world):
        P = world.player
        return self.mode == 'fps' and P.alive() and P.att[HEAD]

    def update(self, world, dt):
        P, C = world.player, world.cpu
        pc, cc = P.pt[CHEST], C.pt[CHEST]
        F = P.F
        if self.fps_active(world):
            # 一人称:目の位置から、正面やや下と相手の胸の間を見る
            hd = P.pt[HEAD]
            want = (hd.x + F[0] * 0.10, hd.y + 0.035, hd.z + F[2] * 0.10)
            ahead = (want[0] + F[0] * 2.0, want[1] - 0.35, want[2] + F[2] * 2.0)
            look = lerp(ahead, (cc.x, cc.y, cc.z), 0.35)
            k = 1.0 - math.exp(-dt * 25.0)
        else:
            R = (-F[2], 0.0, F[0])
            want = (pc.x - F[0] * 2.35 + R[0] * 0.75, 1.82,
                    pc.z - F[2] * 2.35 + R[2] * 0.75)
            look = (pc.x + (cc.x - pc.x) * 0.55, 1.15, pc.z + (cc.z - pc.z) * 0.55)
            k = 1.0 - math.exp(-dt * 6.0)
        self.pos = lerp(self.pos, want, k)
        self.look = lerp(self.look, look, k)
        sh = world.shake
        self.jitter = ((random.random() - 0.5) * sh, (random.random() - 0.5) * sh,
                       (random.random() - 0.5) * sh)
        fw = norm(sub(self.look, self.pos))
        right = norm(cross(fw, UP))
        self.fw, self.right, self.up = fw, right, cross(right, fw)

    def eye(self):
        return add(self.pos, self.jitter)

    def quat(self):
        return quat_from_basis(self.right, self.up, mul(self.fw, -1.0))

    def ray(self, sx, sy, W, H):
        nx = 2.0 * sx / W - 1.0
        ny = 1.0 - 2.0 * sy / H
        a = W / float(H)
        return norm(add(self.fw, add(mul(self.right, nx * self.th * a),
                                     mul(self.up, ny * self.th))))

    def project(self, p, W, H):
        v = sub(p, self.pos)
        z = dot(v, self.fw)
        if z < 1e-3:
            return None
        a = W / float(H)
        x = dot(v, self.right) / (z * self.th * a)
        y = dot(v, self.up) / (z * self.th)
        return ((x + 1.0) * W * 0.5, (1.0 - y) * H * 0.5, z)

    def drag_target(self, fighter, sx, sy, W, H):
        """指の位置 → 剣先の目標(プレイヤー前方 1.15m の画面平行面上)"""
        d = self.ray(sx, sy, W, H)
        c = fighter.pt[CHEST]
        F = fighter.F
        P0 = (c.x + F[0] * 1.15, c.y, c.z + F[2] * 1.15)
        n = self.fw
        den = dot(d, n)
        if abs(den) < 1e-6:
            return None
        t = dot(sub(P0, self.pos), n) / den
        return add(self.pos, mul(d, t))


