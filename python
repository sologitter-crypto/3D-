            elif not ok:
                draw_text('封印', (x, y + ch * 0.25, cw, 24), 18, (1, 1, 1, 0.8),
                          ui.ALIGN_CENTER)
                draw_text('前の景を制覇せよ', (x, y + ch * 0.25 + 24, cw, 18), 11,
