class AI(object):
    WINDUP = 0.30
    STRIKE = 0.24

    def __init__(self, me, foe, level):
        self.me, self.foe, self.level = me, foe, level
        self.state = 'approach'
        self.t = 0.0
        self.clock = 0.0
        self.cool = 1.2
        self.parry_ready = True
        self.target = None
        self.W = None
        self.side = 1.0

    def move(self, fwd, f_amt, r_amt):
        R = self.me.R()
        mx = fwd[0] * f_amt + R[0] * r_amt
        mz = fwd[1] * f_amt + R[2] * r_amt
        l = math.hypot(mx, mz)
        if l > 1.0:
            mx, mz = mx / l, mz / l
        self.me.mvx, self.me.mvz = mx, mz

    def pick(self):
        foe = self.foe
        cand = []
        for s in foe.segs:
            if s.dead or not (foe.att[s.i] and foe.att[s.j]):
                continue
            w = {'head': 0.12, 'neck': 0.12, 'torso': 0.12, 'farm': 0.26,
                 'uarm': 0.14, 'thigh': 0.16, 'shin': 0.08}.get(s.part.split('_')[0], 0.0)
            if w > 0:
                cand.append((w, s))
        if not cand:
            return None
        r = random.random() * sum(w for w, s in cand)
        for w, s in cand:
            r -= w
            if r <= 0:
                return s
        return cand[-1][1]

    def target_point(self):
        s = self.target
        foe = self.foe
        if s is None or s.dead or not (foe.att[s.i] and foe.att[s.j]):
            c = foe.pt[CHEST]
            return (c.x, c.y, c.z)
        a, b = foe.pt[s.i], foe.pt[s.j]
        u = 0.62 if s.part.split('_')[0] in ('farm', 'uarm', 'thigh', 'shin') else 0.5
        return lerp(a.pos(), b.pos(), u)

    def windup_point(self):
        me = self.me
        S = me.shoulder_center()
        F, R = me.F, me.R()
        h = self.target_point()[1]
        if self.target is not None and self.target.part == 'neck':
            r, u, f = 0.80 * self.side, 0.12, 0.10       # 首は横薙ぎ
        elif h > 1.25:
            r, u, f = 0.25 * self.side, 0.62, -0.05
        elif h > 0.75:
            r, u, f = 0.75 * self.side, 0.15, 0.10
        else:
            r, u, f = 0.65 * self.side, -0.30, 0.25
        return (S[0] + R[0] * r + F[0] * f, S[1] + u, S[2] + R[2] * r + F[2] * f)

    def think(self, dt):
        me, foe = self.me, self.foe
        self.clock += dt
        if not me.alive() or me.down or me.getup:
            me.mvx = me.mvz = 0.0
            me.T_goal = None
            self.state = 'approach'
            return
        pm, pf = me.pt[PELVIS], foe.pt[PELVIS]
        dx, dz = pf.x - pm.x, pf.z - pm.z
        dist = math.hypot(dx, dz) or 1e-3
        fwd = (dx / dist, dz / dist)
        self.t += dt
        self.cool -= dt

        if not me.armed:
            self.move(fwd, -1.0, 0.0)
            me.T_goal = None
            return
        if not foe.alive():
            self.move(fwd, 0.0, 0.0)
            me.T_goal = None
            return

        ft = foe.pt[TIP]
        fsp = length(ft.vel(1.0 / SDT))
        if fsp < 2.0:
            self.parry_ready = True
        if (self.state in ('approach', 'recover') and self.parry_ready
                and foe.armed and fsp > 5.0):
            if length(sub(ft.pos(), me.pt[CHEST].pos())) < 1.35:
                self.parry_ready = False
                if random.random() < 0.30 * self.level:
                    self.state, self.t = 'parry', 0.0

        st = self.state
        if st == 'approach':
            want = 1.45
            f_amt = 1.0 if dist > want + 0.10 else (-0.8 if dist < want - 0.30 else 0.0)
            self.move(fwd, f_amt, 0.35 * math.sin(self.clock * 1.3))
            me.T_goal = None
            if self.cool <= 0.0 and dist < 1.85:
                self.target = self.pick()
                self.side = random.choice((-1.0, 1.0))
                self.state, self.t = 'windup', 0.0
        elif st == 'windup':
            self.move(fwd, 0.0, 0.0)
            me.T_goal = self.windup_point()
            if self.t > self.WINDUP / self.level:
                self.W = me.T
                self.state, self.t = 'strike', 0.0
        elif st == 'strike':
            self.move(fwd, 0.9, 0.0)
            P = self.target_point()
            W = self.W
            FT = add(P, mul(sub(P, W), 0.7))
            u = self.t / self.STRIKE
            me.T_goal = lerp(W, P, u / 0.6) if u < 0.6 else lerp(P, FT, (u - 0.6) / 0.4)
            if self.t > self.STRIKE:
                self.state, self.t = 'recover', 0.0
        elif st == 'recover':
            self.move(fwd, -0.7, 0.0)
            me.T_goal = None
            if self.t > 0.5:
                self.state, self.t = 'approach', 0.0
                self.cool = random.uniform(0.7, 1.8) / self.level
        elif st == 'parry':
            self.move(fwd, -0.3, 0.0)
            M = lerp(foe.pt[GRIP].pos(), foe.pt[TIP].pos(), 0.5)
            S = me.shoulder_center()
            me.T_goal = add(add(S, mul(norm(sub(M, S)), 1.1)), (0.0, 0.08, 0.0))
            if self.t > 0.32:
                self.state, self.t = 'recover', 0.0


