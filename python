    def scene_castle(self):
        stone = self.mat('cstone', (0.45, 0.44, 0.43), 0.95)
        plaster = self.mat('plaster', (0.90, 0.90, 0.88), 0.85)
        roof = self.mat('croof', (0.20, 0.22, 0.26), 0.6)
        snow = self.mat('snowcap', (0.95, 0.96, 0.98), 0.7)
        for a in (0.0, math.pi * 0.5, math.pi, math.pi * 1.5):
            c, s = math.cos(a), math.sin(a)
            x, z = c * 13.0, s * 13.0
            w, l = (1.2, 26.0) if abs(c) > 0.5 else (26.0, 1.2)
            self.box(w, 1.6, l, stone, (x, 0.8, z))
            self.box(w * 0.7, 1.2, l * 0.98 if l > w else l * 0.7, plaster, (x, 2.2, z))
            self.box(w * 1.1, 0.3, l * 1.02 if l > w else l * 1.1, roof, (x, 2.95, z))
            self.box(w * 1.0, 0.08, l * 1.0 if l > w else l * 1.0, snow, (x, 3.14, z))
        tx, tz = -20.0, -8.0
        self.box(9.0, 4.0, 9.0, stone, (tx, 2.0, tz), 0.1)
        y = 4.0
        for w, h in ((7.0, 3.0), (5.2, 2.6), (3.6, 2.2)):
            self.box(w, h, w, plaster, (tx, y + h * 0.5, tz))
            y += h
            self.en(SCNPyramid.pyramidWithWidth_height_length_(w + 2.0, 1.4, w + 2.0),
                    roof, (tx, y, tz))
            self.en(SCNPyramid.pyramidWithWidth_height_length_(w + 1.8, 1.3, w + 1.8),
                    snow, (tx, y + 0.12, tz))
            y += 1.0
        pine = self.mat('pine', (0.10, 0.19, 0.14), 0.95)
        bark = self.mat('bark', (0.20, 0.13, 0.11), 0.9)
        for x, z in ((8, 8), (-8, 9), (9, -8), (-9, -9)):
            self.en(SCNCylinder.cylinderWithRadius_height_(0.22, 2.4), bark, (x, 1.2, z))
            for k in range(3):
                self.en(SCNCone.coneWithTopRadius_bottomRadius_height_(0, 1.9 - k * 0.45, 1.8),
                        pine, (x, 2.6 + k, z))
                self.en(SCNCone.coneWithTopRadius_bottomRadius_height_(0, 1.5 - k * 0.4, 0.6),
                        snow, (x, 3.2 + k, z))
        self.lanterns(cap=snow)

