            ps.setParticleAngleVariation_(180.0)
            ps.setParticleAngularVelocity_(80.0)
            ps.setParticleAngularVelocityVariation_(120.0)
            ps.setAcceleration_(V3(0.25, -0.32, 0.12), restype=None, argtypes=[V3])
            ps.setBlendMode_(4)
            shape, y = (16, 0.2, 16), 5.5
        elif kind == 'firefly':
            ps.setBirthRate_(7.0 * q)
            ps.setParticleLifeSpan_(6.0)
            ps.setParticleSize_(0.022)
            ps.setParticleImage_(ObjCInstance(tex_dot((0.8, 1.0, 0.45), True)))
            ps.setParticleColor_(color((0.75, 1.0, 0.40)))
            ps.setParticleVelocity_(0.15)
            ps.setParticleVelocityVariation_(0.15)
            ps.setSpreadingAngle_(180.0)
            ps.setAcceleration_(V3(0.0, 0.02, 0.0), restype=None, argtypes=[V3])
            ps.setBlendMode_(0)
            shape, y = (14, 2.0, 14), 1.3
        elif kind == 'snow':
            ps.setBirthRate_(170.0 * q)
            ps.setParticleLifeSpan_(7.0)
            ps.setParticleSize_(0.02)
            ps.setParticleSizeVariation_(0.01)
            ps.setParticleImage_(ObjCInstance(tex_dot((1.0, 1.0, 1.0), True)))
            ps.setParticleColor_(color((1.0, 1.0, 1.0)))
            ps.setParticleVelocity_(0.2)
            ps.setAcceleration_(V3(0.12, -0.55, 0.05), restype=None, argtypes=[V3])
            ps.setBlendMode_(4)
            shape, y = (20, 0.2, 20), 7.0
        else:
            ps.setBirthRate_(60.0 * q)
            ps.setParticleLifeSpan_(4.0)
            ps.setParticleSize_(0.018)
            ps.setParticleImage_(ObjCInstance(tex_dot((1.0, 0.6, 0.2), True)))
            ps.setParticleColor_(color((1.0, 0.55, 0.18)))
            ps.setParticleVelocity_(0.4)
            ps.setAcceleration_(V3(0.15, 0.6, 0.05), restype=None, argtypes=[V3])
            ps.setBlendMode_(0)
            shape, y = (16, 0.2, 16), 0.2
        ps.setEmitterShape_(SCNBox.boxWithWidth_height_length_chamferRadius_(
            shape[0], shape[1], shape[2], 0))
        n = SCNNode.node()
        set_pos(n, (0.0, y, 0.0))
        n.addParticleSystem_(ps)
        self.env.addChildNode_(n)

    def build_effects(self):
        spark = ObjCInstance(tex_dot((1.0, 0.95, 0.8), True))
        drop = ObjCInstance(tex_dot((1.0, 1.0, 1.0), False))
        self.ps = {}
        for kind in ('spark', 'hit', 'cut'):
            p = SCNParticleSystem.particleSystem()
            p.setLoops_(False)
            p.setEmissionDuration_(0.05)
            if kind == 'spark':
                p.setBirthRate_(900.0)
                p.setParticleLifeSpan_(0.28)
                p.setParticleLifeSpanVariation_(0.12)
                p.setParticleVelocity_(4.5)
                p.setParticleVelocityVariation_(2.5)
                p.setSpreadingAngle_(180.0)
                p.setParticleSize_(0.010)
                p.setParticleImage_(spark)
                p.setParticleColor_(color((1.0, 0.82, 0.45)))
                p.setBlendMode_(0)
                p.setAcceleration_(V3(0, -7.0, 0), restype=None, argtypes=[V3])
            else:
                red = BLOOD
                p.setBirthRate_(900.0 if kind == 'cut' else 380.0)
                p.setEmissionDuration_(0.09 if kind == 'cut' else 0.05)
                p.setParticleLifeSpan_(0.8)
                p.setParticleLifeSpanVariation_(0.3)
                p.setParticleVelocity_(2.8 if kind == 'cut' else 1.8)
                p.setParticleVelocityVariation_(1.4)
                p.setSpreadingAngle_(50.0)
                p.setParticleSize_(0.012)
                p.setParticleSizeVariation_(0.007)
                p.setParticleImage_(drop if red else spark)
                p.setParticleColor_(color((0.45, 0.02, 0.03)) if red
                                    else color((1.0, 0.95, 0.9)))
                p.setBlendMode_(4 if red else 0)
                p.setAcceleration_(V3(0, -9.8, 0), restype=None, argtypes=[V3])
            opt(p.setLightingEnabled_, False)
            self.ps[kind] = p

    def burst(self, kind, pos, direction):
        p = self.ps[kind].copy()
        if direction is not None:
            p.setEmittingDirection_(V3(direction[0], direction[1], direction[2]),
                                    restype=None, argtypes=[V3])
        n = SCNNode.node()
        set_pos(n, pos)
        n.addParticleSystem_(p)
        self.root.addChildNode_(n)
        self.bursts.append((n, time.time() + 2.0))

    # ---------- 人体 ----------
    def fmat(self, f, key):
        pal = f.pal
        if key == 'skin':
            return self.mat('skin', (0.80, 0.60, 0.48), 0.52)
        if key == 'tabi':
            return self.mat('tabi', (0.88, 0.87, 0.84), 0.9)
        if key == 'collar':
            return self.mat('collar', (0.90, 0.89, 0.85), 0.9)
        return self.mat(pal['name'] + key, pal[key], 0.92)

    def cut_mats(self):
        if BLOOD:
            fl = self.mat('flesh', (0.50, 0.05, 0.06), 0.35, emit=(0.06, 0.0, 0.0))
        else:
            fl = self.mat('fleshw', (0.80, 0.76, 0.72), 0.6)
        return fl, self.mat('bone', (0.92, 0.88, 0.80), 0.55)

    def seg_node(self, f, seg):
        if seg.mat is None:
            return None
        m = self.fmat(f, seg.mat)
        fl, bn = self.cut_mats()
        if self.mesh_ok:
            try:
                key = (f.pal['name'], seg.prof, seg.mat, round(seg.L0, 4),
                       round(seg.u0, 4), round(seg.u1, 4), seg.cap0, seg.cap1)
                keys = PROFILES[seg.prof]
                n = self.mesh_node(key, lambda: loft(keys, seg.L0, seg.u0, seg.u1,
                                                     seg.ys, seg.cap0, seg.cap1),
                                   [m, fl, bn])
                for pname, mk in EXTRAS.get(seg.prof, ()):
                    a, b = prof_range(pname)
                    if a >= seg.u0 - 1e-6 and b <= seg.u1 + 1e-6:
                        pk = PROFILES[pname]
                        self.mesh_node(('x', f.pal['name'], pname, round(seg.L0, 4)),
                                       lambda: loft(pk, seg.L0, a, b, seg.ys,
                                                    'round', 'round', grow=0.004),
                                       [self.fmat(f, mk)], parent=n)
                if seg.prof == 'foot':
                    zori = self.mat('zori', (0.72, 0.60, 0.40), 0.95)
                    self.node(SCNBox.boxWithWidth_height_length_chamferRadius_(
                        0.095, 0.25, 0.014, 0.006), zori, parent=n,
                        pos=(0, -0.03 - seg.ys, 0.052))
                return n
            except Exception as e:
                self.mesh_fail(e)
        L = max(seg.L0 * (seg.u1 - seg.u0) * 0.8, 0.02)
        return self.node(SCNCapsule.capsuleWithCapRadius_height_(seg.r, L + 2 * seg.r), m)

    def build_fighter(self, f):
        d = {'cache': {}}
        skin = self.fmat(f, 'skin')
        hair = self.mat('hair', (0.025, 0.022, 0.024), 0.45)
        d['hands'] = {}
        for h in (HAND_L, HAND_R):
            n = None
            if self.mesh_ok:
                try:
                    n = self.mesh_node('hand', lambda: loft(PROFILES['hand'], 0.10, -0.15,
                                                            1.0, 0.0, 'round', 'round'),
                                       [skin])
                    self.node(SCNCapsule.capsuleWithCapRadius_height_(0.014, 0.06), skin,
                              parent=n, pos=(0.028 if h == HAND_R else -0.028, 0.01, -0.02))
                except Exception as e:
                    self.mesh_fail(e)
                    n = None
            if n is None:
                n = self.node(SCNSphere.sphereWithRadius_(0.046), skin)
            d['hands'][h] = {'node': n}
        # 頭(ローカル: Y 上, X 右, -Z 顔の向き)
        hn = SCNNode.node()
        self.root.addChildNode_(hn)
        made = False
        if self.mesh_ok:
            try:
                self.mesh_node('head', lambda: (lambda v, t: (v, [t]))(*head_mesh()),
                               [skin], parent=hn)
                self.mesh_node('hair', lambda: (lambda v, t: (v, [t]))(*hair_mesh()),
                               [hair], parent=hn)
                made = True
            except Exception as e:
                self.mesh_fail(e)
        if not made:
            self.node(SCNSphere.sphereWithRadius_(0.105), skin, parent=hn)
        for sx in (-1, 1):
            e = self.node(SCNSphere.sphereWithRadius_(0.028), skin, parent=hn,
                          pos=(0.079 * sx, -0.004, 0.012))
            set_scale(e, 0.36, 1.0, 0.68)
            de = norm((0.36 * sx, 0.14, -0.92))
            c = sub(head_point(de), mul(de, 0.0075))
            self.node(SCNSphere.sphereWithRadius_(0.0118),
                      self.mat('eyew', (0.86, 0.84, 0.80), 0.25), parent=hn, pos=c)
            self.node(SCNSphere.sphereWithRadius_(0.0058),
                      self.mat('iris', (0.10, 0.06, 0.04), 0.15), parent=hn,
                      pos=add(c, mul(de, 0.0092)))
        mage = self.node(SCNCapsule.capsuleWithCapRadius_height_(0.018, 0.11), hair,
                         parent=hn, pos=(0, 0.118, 0.03))
        set_euler(mage, math.pi * 0.5 - 0.3, 0, 0)
        band = self.node(SCNTorus.torusWithRingRadius_pipeRadius_(0.0835, 0.0105),
                         self.fmat(f, 'band'), parent=hn, pos=(0, 0.056, 0.004))
        set_scale(band, 1.0, 1.0, 1.2)
        d['head'] = {'node': hn, 'mrk': 0, 'hidden': False}
        # 刀(ローカル: Y 刀身, X 刃の向き)
        s = SCNNode.node()
        self.root.addChildNode_(s)
        steel = self.mat('steel', (0.93, 0.94, 0.96), 0.14, metal=1.0)
        iron = self.mat('iron', (0.18, 0.16, 0.14), 0.45, metal=0.8)
        gold = self.mat('habaki', (0.85, 0.66, 0.30), 0.3, metal=1.0)
        wrap = self.mat('tsuka', (0.07, 0.07, 0.09), 0.8)
        made = False
        if self.mesh_ok:
            try:
                self.mesh_node('blade', lambda: (lambda v, t: (v, [t]))(*blade_mesh()),
                               [steel], parent=s)
                made = True
            except Exception as e:
                self.mesh_fail(e)
        if not made:
            self.node(SCNBox.boxWithWidth_height_length_chamferRadius_(
                0.030, BLADE, 0.007, 0.002), steel, parent=s, pos=(0.0, BLADE * 0.5, 0))
        self.node(SCNBox.boxWithWidth_height_length_chamferRadius_(0.036, 0.035, 0.012, 0.003),
                  gold, parent=s, pos=(0.0, 0.02, 0))
        self.node(SCNCylinder.cylinderWithRadius_height_(0.042, 0.008), iron, parent=s)
        self.node(SCNCapsule.capsuleWithCapRadius_height_(0.017, 0.27), wrap,
                  parent=s, pos=(0, -0.135, 0))
        d['sword'] = {'node': s, 'mrk': 0}
        self.fdata[f] = d
        for seg in f.segs:
            seg.node = self.seg_node(f, seg)
            seg.mrk_n = 0

    def drop_fighter(self, f):
        d = self.fdata.pop(f, None)
        if d:
            for h in d['hands'].values():
                h['node'].removeFromParentNode()
            d['head']['node'].removeFromParentNode()
            d['sword']['node'].removeFromParentNode()
        for seg in f.segs:
            if seg.node is not None:
                seg.node.removeFromParentNode()
                seg.node = None

    # ---------- 血痕 ----------
    def decal(self, parent, pos, nrm, size, var, stretch=1.0):
        g = SCNPlane.planeWithWidth_height_(size, size * stretch)
        n = self.node(g, self.splats[var % 4], parent=parent, pos=pos)
        Zd = norm(nrm)
        Xd = cross((0.0, 1.0, 0.0), Zd)
        if length(Xd) < 1e-3:
            Xd = (1.0, 0.0, 0.0)
        Xd = norm(Xd)
        set_rot(n, quat_from_basis(Xd, cross(Zd, Xd), Zd))
        return n

    def sync_ground(self, world):
        live = set()
        for gid, x, z, size, ang, var in world.ground:
            live.add(gid)
            if gid in self.gnodes:
                continue
            g = SCNPlane.planeWithWidth_height_(size, size)
            n = self.node(g, self.splats[var], pos=(x, 0.003 + (gid % 7) * 0.0004, z))
            c, s = math.cos(ang), math.sin(ang)
            set_rot(n, quat_from_basis((c, 0.0, s), (s, 0.0, -c), (0.0, 1.0, 0.0)))
            self.gnodes[gid] = n
        for gid in list(self.gnodes):
            if gid not in live:
                self.gnodes.pop(gid).removeFromParentNode()

    # ---------- 毎フレーム ----------
    def moved(self, cache, key, p, q):
        old = cache.get(key)
        if old is not None:
            if (abs(old[0] - p[0]) + abs(old[1] - p[1]) + abs(old[2] - p[2]) < 2e-4 and
                    abs(old[3] - q[0]) + abs(old[4] - q[1]) + abs(old[5] - q[2]) +
                    abs(old[6] - q[3]) < 2e-4):
                return False
        cache[key] = (p[0], p[1], p[2], q[0], q[1], q[2], q[3])
        return True

    def sync(self, world, cam):
        if world.gen != self.gen or id(world) != self.world_id:
            for f in list(self.fdata):
                self.drop_fighter(f)
            for n, _ in self.bursts:
                n.removeFromParentNode()
            self.bursts = []
            self.build_fighter(world.player)
            self.build_fighter(world.cpu)
            self.gen = world.gen
            self.world_id = id(world)
        if cam.fov != self.fov:
            opt(self.cam.setFieldOfView_, cam.fov)
            self.fov = cam.fov

        SCNTransaction.begin()
        opt(SCNTransaction.setDisableActions_, True)
        hide = cam.fps_active(world)
        for f in (world.player, world.cpu):
            self.sync_fighter(f, hide and f is world.player)
        set_pos(self.cam_node, cam.eye())
        set_rot(self.cam_node, cam.quat())
        for kind, pos, d in world.fx:
            self.burst(kind, pos, d)
        world.fx = []
        self.sync_ground(world)
        for l, base in self.fire_lights:
            l.setIntensity_(base * random.uniform(0.75, 1.2))
        now = time.time()
        keep = []
        for n, t in self.bursts:
            if t < now:
                n.removeFromParentNode()
            else:
                keep.append((n, t))
        self.bursts = keep
        SCNTransaction.commit()

    def sync_fighter(self, f, hide_head):
        d = self.fdata[f]
        cache = d['cache']
        pt = f.pt
        alive = []
        for seg in f.segs:
            if seg.dead:
                if seg.node is not None:
                    seg.node.removeFromParentNode()
                    seg.node = None
                continue
            alive.append(seg)
            if seg.prof is None:
                continue
            fr = f.seg_frame(seg)
            if fr is None:
                continue
            if seg.node is None:
                seg.node = self.seg_node(f, seg)
                seg.mrk_n = 0
            if seg.node is None:
                continue
            a, b = pt[seg.i], pt[seg.j]
            mid = ((a.x + b.x) * 0.5, (a.y + b.y) * 0.5, (a.z + b.z) * 0.5)
            q = quat_from_basis(*fr)
            if self.moved(cache, seg.key, mid, q):
                set_pos(seg.node, mid)
                set_rot(seg.node, q)
            while seg.mrk_n < len(seg.marks):
                pos, nrm, size, var = seg.marks[seg.mrk_n]
                self.decal(seg.node, pos, nrm, size, var)
                seg.mrk_n += 1
        f.segs = alive

        for h, hd in d['hands'].items():
            fr = f.hand_frame(h)
            p = pt[h].pos()
            q = quat_from_basis(*fr)
            if self.moved(cache, ('h', h), p, q):
                set_pos(hd['node'], p)
                set_rot(hd['node'], q)

        hdd = d['head']
        if hdd['hidden'] != hide_head:
            hdd['node'].setHidden_(hide_head)
            hdd['hidden'] = hide_head
        fr = f.head_frame()
        hp = pt[HEAD].pos()
        q = quat_from_basis(*fr)
        if self.moved(cache, 'head', hp, q):
            set_pos(hdd['node'], hp)
            set_rot(hdd['node'], q)
        while hdd['mrk'] < len(f.head_marks):
            pos, nrm, size, var = f.head_marks[hdd['mrk']]
            self.decal(hdd['node'], pos, nrm, size, var)
            hdd['mrk'] += 1

        g, t = pt[GRIP], pt[TIP]
        Y = norm(sub(t.pos(), g.pos()))
        X = norm(sub(f.edge, mul(Y, dot(f.edge, Y))))
        if X == (0.0, 0.0, 0.0):
            X = basis_y(Y)[0]
        q = quat_from_basis(X, Y, cross(X, Y))
        sd = d['sword']
        if self.moved(cache, 'sword', g.pos(), q):
            set_pos(sd['node'], g.pos())
            set_rot(sd['node'], q)
        while sd['mrk'] < len(f.sword_marks):
            y, var = f.sword_marks[sd['mrk']]
            x = -0.018 * (y / BLADE) ** 2
            for side in (-1.0, 1.0):
                self.decal(sd['node'], (x, y, side * 0.0042), (0.0, 0.0, side),
                           0.024, var, stretch=2.2)
            sd['mrk'] += 1


