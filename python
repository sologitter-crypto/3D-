def wound_color(f, key):
    if key in f.lost:
        return (0.95, 0.18, 0.16, 0.95)
    n = f.wounds.get(key, 0)
    return [(1, 1, 1, 0.8), (1.0, 0.78, 0.62, 0.9),
            (1.0, 0.48, 0.30, 0.95)][min(n, 2)]


def draw_text(s, rect, size, col, align=None):
    al = ui.ALIGN_LEFT if align is None else align
    ui.draw_string(s, rect=(rect[0] + 1, rect[1] + 1.5, rect[2], rect[3]),
                   font=(FONT, size), color=(0, 0, 0, 0.55), alignment=al)
    ui.draw_string(s, rect=rect, font=(FONT, size), color=col, alignment=al)


class HUD(ui.View):
    def draw(self):
        g = getattr(self, 'game', None)
        if g is None or g.mode == 'menu':
            return
        wd = g.world
        W, H = self.width, self.height
        bw = W * 0.28
        self.bar(24, 22, bw, wd.player, False)
        self.bar(W - 24 - bw, 22, bw, wd.cpu, True)
        self.figure(24 + bw + 26, 48, wd.player)
        self.figure(W - 24 - bw - 26, 48, wd.cpu)
        draw_text(wd.st['name'], (0, 10, W, 20), 14, (1, 0.95, 0.85, 0.9), ui.ALIGN_CENTER)
        marks = '●' * wd.wins[0] + '○' * (WIN_ROUNDS - wd.wins[0])
        marks2 = '●' * wd.wins[1] + '○' * (WIN_ROUNDS - wd.wins[1])
        draw_text('%s   %s' % (marks, marks2), (0, 30, W, 22), 16,
                  (1, 0.97, 0.9), ui.ALIGN_CENTER)
        if not wd.player.armed and wd.player.alive():
            draw_text('刀を失った', (24, 60, bw, 20), 13, (1, 0.6, 0.55))
        y = H * 0.24
        for text, ttl, col in wd.events:
            a = clamp(ttl / 0.4, 0.0, 1.0)
            draw_text(text, (0, y, W, 34), 24, (col[0], col[1], col[2], a), ui.ALIGN_CENTER)
            y += 34
        if g.mode == 'play' and wd.state == 'over' and wd.match is None and wd.over_t > 1.0:
            draw_text('画面をタップで次の勝負', (0, H * 0.24 + 70, W, 24), 15,
                      (1, 0.95, 0.88, 0.85), ui.ALIGN_CENTER)
        # 操作面の境目(右側が剣)
        x0 = W * PAD_X0
        ui.set_color((1, 1, 1, 0.07))
        ui.Path.rect(x0, H * 0.18, 1.5, H * 0.7).fill()
        if g.joy:
            ox, oy, cx, cy = g.joy
            ui.set_color((1, 1, 1, 0.14))
            ui.Path.oval(ox - 56, oy - 56, 112, 112).fill()
            dx, dy = cx - ox, cy - oy
            l = math.hypot(dx, dy)
            if l > 56:
                dx, dy = dx * 56 / l, dy * 56 / l
            ui.set_color((1, 1, 1, 0.45))
            ui.Path.oval(ox + dx - 24, oy + dy - 24, 48, 48).fill()
        tr = g.trail
        if len(tr) > 1:
            now = time.perf_counter()
            for i in range(1, len(tr)):
                a = clamp(1.0 - (now - tr[i][2]) / 0.35, 0.0, 1.0)
                if a <= 0:
                    continue
                p = ui.Path()
                p.move_to(tr[i - 1][0], tr[i - 1][1])
                p.line_to(tr[i][0], tr[i][1])
                p.line_width = 2 + 8 * a
                p.line_cap_style = 1
                ui.set_color((1.0, 0.97, 0.9, 0.5 * a))
                p.stroke()
        if g.drag and g.drag[5] > 6:
            vx, vy = g.pad_map(g.drag[3], g.drag[4])
            ui.set_color((1.0, 0.95, 0.85, 0.75))
            p = ui.Path.oval(vx - 9, vy - 9, 18, 18)
            p.line_width = 2
            p.stroke()
        if wd.t < 7.0 and wd.round_no == 1:
            a = clamp((7.0 - wd.t) / 1.0, 0.0, 1.0)
            draw_text('左:移動 右側だけで剣を全方向に振れる 右タップ:突き',
                      (0, H - 34, W, 22), 14, (1, 1, 1, 0.8 * a), ui.ALIGN_CENTER)
        if MESH_ERR and not g.rend.mesh_ok:
            draw_text('人体メッシュ生成失敗: ' + MESH_ERR[-1][:90], (12, H - 20, W, 16), 10,
                      (1, 0.6, 0.5, 0.9))

    def bar(self, x, y, w, f, flip):
        ui.set_color((0.06, 0.04, 0.05, 0.7))
        ui.Path.rounded_rect(x - 3, y - 3, w + 6, 20, 4).fill()
        ui.set_color((1, 1, 1, 0.1))
        ui.Path.rect(x, y, w, 14).fill()
        gw = w * clamp(f.hp_ghost / MAX_HP, 0, 1)
        ui.set_color((0.98, 0.82, 0.45, 0.6))
        ui.Path.rect(x + (w - gw if flip else 0), y, gw, 14).fill()
        bw = w * clamp(f.hp / MAX_HP, 0, 1)
        ui.set_color(f.pal['hud'])
        ui.Path.rect(x + (w - bw if flip else 0), y, bw, 14).fill()
        ui.set_color((1, 1, 1, 0.22))
        ui.Path.rect(x + (w - bw if flip else 0), y, bw, 5).fill()

    def figure(self, cx, cy, f):
        ok = (1, 1, 1, 0.8)
        ui.set_color(wound_color(f, 'neck'))
        if 'neck' in f.lost:
            ui.Path.oval(cx + 6, cy - 40, 10, 10).fill()
        else:
            ui.Path.oval(cx - 5, cy - 32, 10, 10).fill()
        p = ui.Path()
        p.move_to(cx, cy - 22)
        p.line_to(cx, cy - 18)
        p.line_width = 3
        p.stroke()
        ui.set_color(ok)
        p = ui.Path()
        p.move_to(cx, cy - 18)
        p.line_to(cx, cy + 4)
        p.line_width = 4
        p.stroke()
        p = ui.Path()
        p.move_to(cx - 8, cy - 17)
        p.line_to(cx + 8, cy - 17)
        p.line_width = 3
        p.stroke()
        for key, a, b in LIMB_FIG:
            p = ui.Path()
            p.move_to(cx + a[0], cy + a[1])
            p.line_to(cx + b[0], cy + b[1])
            p.line_width = 3
            ui.set_color(wound_color(f, key))
            p.stroke()


