class Fighter(object):
    _key = 0

    def __init__(self, name, spawn, facing, pal, is_player):
        self.name = name
        self.pal = pal
        self.is_player = is_player
        self.F = facing
        self.build(spawn)

    def build(self, spawn):
        x0, z0 = spawn
        F = self.F
        R = (-F[2], 0.0, F[0])

        def W(r, u, f):
            return (x0 + R[0] * r + F[0] * f, u, z0 + R[2] * r + F[2] * f)

        P = {}
        P[PELVIS] = W(0.0, 0.97, 0.0)
        P[CHEST] = W(0.0, 1.29, 0.0)
        P[NECK] = W(0.0, 1.49, 0.01)
        P[HEAD] = W(0.0, 1.64, 0.02)
        P[SHO_L] = W(-0.19, 1.43, 0.0)
        P[SHO_R] = W(0.19, 1.43, 0.0)
        P[HIP_L] = W(-0.10, 0.94, 0.0)
        P[HIP_R] = W(0.10, 0.94, 0.0)
        P[ANK_L] = W(-0.12, 0.08, -0.17)
        P[ANK_R] = W(0.12, 0.08, 0.17)
        P[TOE_L] = W(-0.12, 0.03, -0.02)
        P[TOE_R] = W(0.12, 0.03, 0.32)
        bd = norm((F[0] * 0.75, 0.66, F[2] * 0.75))
        P[GRIP] = W(0.0, 1.12, 0.40)
        P[TIP] = add(P[GRIP], mul(bd, BLADE))
        P[HAND_R] = sub(P[GRIP], mul(bd, 0.035))
        P[HAND_L] = sub(P[GRIP], mul(bd, 0.13))
        P[KNEE_L] = ik(P[HIP_L], P[ANK_L], L_THIGH, L_SHIN, F)
        P[KNEE_R] = ik(P[HIP_R], P[ANK_R], L_THIGH, L_SHIN, F)
        bend_l = norm(add(add(mul(UP, -1.0), mul(F, -0.3)), mul(R, -0.45)))
        bend_r = norm(add(add(mul(UP, -1.0), mul(F, -0.3)), mul(R, 0.45)))
        P[ELB_L] = ik(P[SHO_L], P[HAND_L], L_UARM, L_FARM, bend_l)
        P[ELB_R] = ik(P[SHO_R], P[HAND_R], L_UARM, L_FARM, bend_r)

        self.pt = [Pt(P[i], MASS[i], RAD[i]) for i in range(NBASE)]
        self.bones = []

        def B(a, b, k=1.0, tag='struct'):
            self.bones.append([a, b, length(sub(P[a], P[b])), k, tag])

        for a, b, k in ((PELVIS, CHEST, 1.0), (CHEST, NECK, 1.0),
                        (NECK, HEAD, 1.0), (CHEST, SHO_L, 1.0),
                        (CHEST, SHO_R, 1.0), (SHO_L, SHO_R, 1.0),
                        (NECK, SHO_L, 0.8), (NECK, SHO_R, 0.8),
                        (PELVIS, HIP_L, 1.0), (PELVIS, HIP_R, 1.0),
                        (HIP_L, HIP_R, 1.0), (CHEST, HIP_L, 0.6),
                        (CHEST, HIP_R, 0.6), (SHO_L, HIP_L, 0.5),
                        (SHO_R, HIP_R, 0.5), (SHO_L, HIP_R, 0.3),
                        (SHO_R, HIP_L, 0.3)):
            B(a, b, k)
        for a, b in ((SHO_L, ELB_L), (ELB_L, HAND_L),
                     (SHO_R, ELB_R), (ELB_R, HAND_R),
                     (HIP_L, KNEE_L), (KNEE_L, ANK_L), (ANK_L, TOE_L),
                     (HIP_R, KNEE_R), (KNEE_R, ANK_R), (ANK_R, TOE_R)):
            B(a, b)
        B(GRIP, TIP)
        # 補助(切断で跨ぐと自動で外れる)。首の張りも補助にして首を断てるようにする
        B(HEAD, CHEST, 0.5, 'aux')
        B(HEAD, SHO_L, 0.3, 'aux')
        B(HEAD, SHO_R, 0.3, 'aux')
        B(KNEE_L, TOE_L, 0.35, 'aux')
        B(KNEE_R, TOE_R, 0.35, 'aux')
        B(PELVIS, ANK_L, 0.30, 'aux')
        B(PELVIS, ANK_R, 0.30, 'aux')
        B(HEAD, PELVIS, 0.40, 'aux')
        B(HAND_R, GRIP, 1.0, 'grip')
        B(HAND_R, TIP, 0.6, 'grip')
        B(HAND_L, GRIP, 1.0, 'grip')
        B(HAND_L, TIP, 0.6, 'grip')

        arm = L_UARM + L_FARM
        leg = L_THIGH + L_SHIN
        self.limits = [
            ('max', SHO_L, HAND_L, arm - 0.005), ('min', SHO_L, HAND_L, 0.14),
            ('max', SHO_R, HAND_R, arm - 0.005), ('min', SHO_R, HAND_R, 0.14),
            ('max', HIP_L, ANK_L, leg - 0.005), ('min', HIP_L, ANK_L, 0.28),
            ('max', HIP_R, ANK_R, leg - 0.005), ('min', HIP_R, ANK_R, 0.28),
            ('knee', HIP_L, KNEE_L, ANK_L, 0.02),
            ('knee', HIP_R, KNEE_R, ANK_R, 0.02),
        ]

        self.segs = []
        for i, j, r, mat, part, sev, prof in SEG_DEFS:
            L0 = length(sub(P[i], P[j]))
            s = self.new_seg(i, j, r, mat, part, sev, prof, L0)
            self.segs.append(s)

        n = len(self.pt)
        self.att = [True] * n
        self.grip_hands = set([HAND_L, HAND_R])
        self.armed = True
        self.crippled = False
        self.lost = set()
        self.wounds = {}
        self.head_marks = []
        self.sword_marks = []
        self.drips = []                 # [点, 残り秒, 次の滴まで, 大きさ]
        self.head_z = mul(F, -1.0)
        # 足の接地位置 [x, z, 振り出し中の状態 or None]
        self.feet = {ANK_L: [P[ANK_L][0], P[ANK_L][2], None],
                     ANK_R: [P[ANK_R][0], P[ANK_R][2], None]}
        self.step_cd = 0.0
        self.bob = 0.0
        self.crouch = 0.0
        self.pins = {}                  # 接地して固定している足 {点: (x, z)}
        # 膝折れ防止の補助骨(骨盤〜足首)。足を上げる間だけ緩める
        self.leg_aux = {}
        for bn in self.bones:
            if bn[4] == 'aux' and bn[0] == PELVIS and bn[1] in (ANK_L, ANK_R):
                self.leg_aux[bn[1]] = bn
        self.hand_z = {HAND_L: mul(F, -1.0), HAND_R: mul(F, -1.0)}

        self.hp = MAX_HP
        self.hp_ghost = MAX_HP
        self.bleed = 0.0
        self.ko = False
        self.down = 0
        self.getup = 0
        self.stun = 0
        self.parry_t = 0
        self.hit_cd = {}
        self.anc_x, self.anc_z = x0, z0
        self.mvx = self.mvz = 0.0
        self.T_goal = None
        self.T = P[TIP]
        self.thrust_t = 0.0
        self.edge = R
        self.foe = None

    def new_seg(self, i, j, r, mat, part, sev, prof, L0,
                u0=None, u1=None, ys=0.0, cap0='round', cap1='round'):
        s = Seg()
        s.i, s.j, s.r, s.mat, s.part, s.sever = i, j, r, mat, part, sev
        s.prof, s.L0 = prof, L0
        if prof is not None:
            a, b = prof_range(prof)
            s.u0 = a if u0 is None else u0
            s.u1 = b if u1 is None else u1
        else:
            s.u0, s.u1 = 0.0, 1.0
        s.ys, s.cap0, s.cap1 = ys, cap0, cap1
        s.dead = False
        s.node = None
        s.zref = mul(self.F, -1.0) if prof != 'foot' else (0.0, -1.0, 0.0)
        s.frame = None
        s.marks = []
        s.mrk_n = 0
        Fighter._key += 1
        s.key = Fighter._key
        return s

    # ---------- 状態 ----------
    def R(self):
        return (-self.F[2], 0.0, self.F[0])

    def grounded(self):
        p, a = self.pt, self.att
        return ((a[ANK_L] and p[ANK_L].y < 0.09) or
                (a[ANK_R] and p[ANK_R].y < 0.09) or
                (a[TOE_L] and p[TOE_L].y < 0.06) or
                (a[TOE_R] and p[TOE_R].y < 0.06))

    def upright(self):
        return self.pt[HEAD].y - self.pt[PELVIS].y

    def alive(self):
        return not self.ko and not self.crippled

    def shoulder_center(self):
        p, a = self.pt, self.att
        if a[SHO_L] and a[SHO_R]:
            return ((p[SHO_L].x + p[SHO_R].x) * 0.5,
                    (p[SHO_L].y + p[SHO_R].y) * 0.5,
                    (p[SHO_L].z + p[SHO_R].z) * 0.5)
        c = p[CHEST]
        return (c.x, c.y + 0.14, c.z)

    def guard_tip(self):
        c = self.pt[CHEST]
        F = self.F
        G = (c.x + F[0] * 0.36, c.y - 0.17, c.z + F[2] * 0.36)
        bd = norm((F[0] * 0.75, 0.66, F[2] * 0.75))
        return add(G, mul(bd, BLADE))

    def solve_grip(self, T):
        S = self.shoulder_center()
        F = self.F
        v = sub(T, S)
        back = dot(v, F)
        if back < -0.35:
            v = add(v, mul(F, -0.35 - back))
        L = length(v)
        if L > REACH:
            v = mul(v, REACH / L)
            L = REACH
        mn = BLADE + 0.22
        if L < mn:
            v = mul(norm(v) if L > 1e-4 else F, mn)
            L = mn
        T = add(S, v)
        g = clamp(L - BLADE, 0.22, 0.56)
        G = add(S, mul(norm(v), g))
        return G, T

    def base_of(self, idx):
        """点 idx を終点とする生きた部位(手なら前腕、頭なら首)"""
        for s in self.segs:
            if not s.dead and s.j == idx and s.i != idx and s.prof is not None:
                return s
        return None

    # ---------- 描画用の姿勢フレーム ----------
    def anat_z(self, seg):
        """解剖学的な背側方向(無ければ None=前フレームから平行移動)"""
        p, a = self.pt, self.att
        if not (a[seg.i] and a[seg.j]):
            return None
        pr = seg.prof
        Y = norm(sub(p[seg.j].pos(), p[seg.i].pos()))
        if pr == 'torso_l':
            X = norm(sub(p[HIP_R].pos(), p[HIP_L].pos()))
            return norm(cross(X, Y))
        if pr in ('torso_u', 'neck'):
            if a[SHO_L] and a[SHO_R]:
                X = norm(sub(p[SHO_R].pos(), p[SHO_L].pos()))
                return norm(cross(X, Y))
            return None
        if pr == 'foot':
            return (0.0, -1.0, 0.0)
        side = seg.part[-1:]
        if pr in ('thigh', 'shin'):
            h, k, an = (HIP_L, KNEE_L, ANK_L) if side == 'l' else (HIP_R, KNEE_R, ANK_R)
            if a[h] and a[k] and a[an]:
                kv = sub(p[k].pos(), lerp(p[h].pos(), p[an].pos(), 0.5))
                if length(kv) > 0.012:
                    return mul(norm(kv), -1.0)
                return mul(self.F, -1.0)
            return None
        if pr in ('uarm', 'farm'):
            s_, e, h = (SHO_L, ELB_L, HAND_L) if side == 'l' else (SHO_R, ELB_R, HAND_R)
            if a[s_] and a[e] and a[h]:
                ev = sub(p[e].pos(), lerp(p[s_].pos(), p[h].pos(), 0.5))
                if length(ev) > 0.012:
                    return norm(ev)
            return None
        return None

    def seg_frame(self, seg):
        a, b = self.pt[seg.i], self.pt[seg.j]
        Y = norm((b.x - a.x, b.y - a.y, b.z - a.z))
        if Y == (0.0, 0.0, 0.0):
            return seg.frame
        ref = seg.zref
        want = self.anat_z(seg)
        if want is not None:
            ref = norm(lerp(ref, want, 0.5))
        fr = frame_from(Y, ref)
        seg.zref = fr[2]
        seg.frame = fr
        return fr

    def head_frame(self):
        s = self.base_of(HEAD)
        base = self.pt[s.i] if s else self.pt[NECK]
        hd = self.pt[HEAD]
        Y = norm(sub(hd.pos(), base.pos()))
        if Y == (0.0, 0.0, 0.0):
            Y = UP
        ref = self.head_z
        if self.att[HEAD]:
            ref = norm(lerp(ref, mul(self.F, -1.0), 0.5))
        fr = frame_from(Y, ref)
        self.head_z = fr[2]
        return fr

    def hand_frame(self, h):
        s = self.base_of(h)
        base = self.pt[s.i] if s else self.pt[h]
        Y = norm(sub(self.pt[h].pos(), base.pos()))
        if Y == (0.0, 0.0, 0.0):
            Y = UP
        ref = self.hand_z[h]
        if s is not None and s.frame is not None:
            ref = norm(lerp(ref, s.frame[2], 0.5))
        fr = frame_from(Y, ref)
        self.hand_z[h] = fr[2]
        return fr

    # ---------- 入力 ----------
    def do_jump(self):
        if (self.grounded() and self.down == 0 and self.getup == 0
                and self.alive()):
            for i, q in enumerate(self.pt):
                if self.att[i]:
                    q.py -= JUMP_V * SDT

    def do_thrust(self):
        if self.armed and self.alive() and self.thrust_t <= 0.0:
            self.thrust_t = 0.36

    def sword_goal(self):
        if self.thrust_t > 0.0 and self.foe is not None:
            ph = 0.36 - self.thrust_t
            c = self.pt[CHEST]
            F = self.F
            if ph < 0.09:
                return (c.x - F[0] * 0.05, c.y + 0.02, c.z - F[2] * 0.05)
            fc = self.foe.pt[CHEST]
            return (fc.x + F[0] * 0.35, fc.y + 0.05, fc.z + F[2] * 0.35)
        return self.T_goal

    # ---------- 制御(サブステップごと) ----------
    def control(self, foe, dt):
        self.pins = {}                  # 倒れた・死んだ時は足を地面から離す
        if not self.alive():
            return
        p, att = self.pt, self.att
        idt = 1.0 / dt
        pel, ch, hd = p[PELVIS], p[CHEST], p[HEAD]

        if self.down == 0 and self.getup == 0:
            dx = foe.pt[PELVIS].x - pel.x
            dz = foe.pt[PELVIS].z - pel.z
            l = math.hypot(dx, dz)
            if l > 0.05:
                fx = self.F[0] + (dx / l - self.F[0]) * 0.06
                fz = self.F[2] + (dz / l - self.F[2]) * 0.06
                l2 = math.hypot(fx, fz) or 1.0
                self.F = (fx / l2, 0.0, fz / l2)
        if self.down > 0:
            return

        F = self.F
        R = (-F[2], 0.0, F[0])
        gu = self.getup > 0
        air = not self.grounded()
        g = 1.9 if gu else (0.25 if air else 1.0)
        if self.stun > 0:
            g *= 0.45

        # 立ち位置の目標(アンカー)は入力で積分する
        if gu:
            self.anc_x, self.anc_z = pel.x, pel.z
        else:
            self.anc_x += self.mvx * SPEED * dt
            self.anc_z += self.mvz * SPEED * dt
            r = math.hypot(self.anc_x, self.anc_z)
            lim = ARENA_R - 0.6
            if r > lim:
                self.anc_x *= lim / r
                self.anc_z *= lim / r
        cx, cz = self.anc_x, self.anc_z
        lx, lz = self.mvx * 0.05, self.mvz * 0.05
        # 剣先の目標が低いほど膝を曲げて腰を落とし、上体を前へ倒す(倒れた相手や脛に届く)
        goal = self.sword_goal() if self.armed else None
        self.crouch = clamp((0.95 - goal[1]) * 0.55, 0.0, 0.30) if goal else 0.0
        lx += F[0] * self.crouch * 0.6
        lz += F[2] * self.crouch * 0.6

        pull(pel, cx, 0, cz, 300 * g, 26 * g, idt, ay=False)
        if att[HEAD]:
            pull(hd, cx + lx, 0, cz + lz, 330 * g, 28 * g, idt, ay=False)
        pull(ch, cx + lx * 0.5, 0, cz + lz * 0.5, 170 * g, 17 * g, idt, ay=False)
        for i, s in ((HIP_L, -1.0), (HIP_R, 1.0)):
            pull(p[i], pel.x + R[0] * 0.10 * s, 0, pel.z + R[2] * 0.10 * s,
                 90 * g, 9 * g, idt, ay=False)
        for i, s in ((SHO_L, -1.0), (SHO_R, 1.0)):
            if att[i]:
                pull(p[i], ch.x + R[0] * 0.19 * s, 0, ch.z + R[2] * 0.19 * s,
                     70 * g, 8 * g, idt, ay=False)
        self.legs(dt, idt, g, gu, air, cx, cz, F, R)

        if gu:
            pull(hd, 0, STAND_H + UP_STAND, 0, 260, 24, idt, ax=False, az=False)
            pull(ch, 0, STAND_H + 0.32, 0, 210, 21, idt, ax=False, az=False)
        if self.crouch > 0.02 and not air and not gu:
            pull(hd, 0, STAND_H + UP_STAND - self.crouch * 1.6, 0, 60, 8, idt,
                 ax=False, az=False)
        if not air or gu:
            pull(pel, 0, STAND_H - self.bob, 0, 240 * g, 19 * g, idt,
                 ax=False, az=False)
            pull(ch, 0, STAND_H + 0.32 - self.bob, 0, 150 * g, 15 * g, idt,
                 ax=False, az=False)
        if gu:
            return

        tvx, tvz = self.mvx * SPEED, self.mvz * SPEED
        gain = SERVO * (0.2 if air else 0.5)
        for i, w in ((PELVIS, 1.0), (CHEST, 0.5)):
            if att[i]:
                q = p[i]
                q.fx += q.m * gain * w * (tvx - (q.x - q.px) * idt)
                q.fz += q.m * gain * w * (tvz - (q.z - q.pz) * idt)

        self.sword_control(dt, idt, F, R)

    def legs(self, dt, idt, g, gu, air, cx, cz, F, R):
        """足運び:片足ずつ持ち上げて踏み出し、接地した足はその場に固定する"""
        p, att = self.pt, self.att
        walk = not (gu or air)
        lead = STEP_T * 0.6
        pel = p[PELVIS]
        # 着地目標は実際の腰の位置を基準にし、脚が届く範囲に収める
        bx = pel.x + (cx - pel.x) * 0.3
        bz = pel.z + (cz - pel.z) * 0.3
        tgt = {}
        for a_i, s, fo in ((ANK_L, -1.0, -0.17), (ANK_R, 1.0, 0.17)):
            tx = bx + R[0] * 0.12 * s + F[0] * fo + self.mvx * SPEED * lead
            tz = bz + R[2] * 0.12 * s + F[2] * fo + self.mvz * SPEED * lead
            dx, dz = tx - pel.x, tz - pel.z
            dl = math.hypot(dx, dz)
            lim = STEP_REACH - 0.03
            if dl > lim:
                tx, tz = pel.x + dx * lim / dl, pel.z + dz * lim / dl
            tgt[a_i] = (tx, tz)
        self.pins = {}
        mv = math.hypot(self.mvx, self.mvz)
        self.bob = WALK_CROUCH * min(1.0, mv) + self.crouch
        if not walk:
            for a_i in (ANK_L, ANK_R):
                ft = self.feet[a_i]
                ft[0], ft[1], ft[2] = p[a_i].x, p[a_i].z, None
        else:
            self.step_cd -= dt
            if self.step_cd <= 0.0 and self.feet[ANK_L][2] is None \
                    and self.feet[ANK_R][2] is None:
                best, be = None, STEP_TRIG
                for a_i in (ANK_L, ANK_R):
                    if not att[a_i]:
                        continue
                    ft = self.feet[a_i]
                    t = tgt[a_i]
                    e = math.hypot(t[0] - ft[0], t[1] - ft[1])
                    # 脚が伸び切りそうな足は優先して踏み出す
                    if math.hypot(pel.x - ft[0], pel.z - ft[1]) > STEP_REACH:
                        e += 1.0
                    if e > be:
                        best, be = a_i, e
                if best is not None:
                    ft = self.feet[best]
                    ft[2] = [0.0, ft[0], ft[1]]
        for a_i, k_i, t_i, h_i in ((ANK_L, KNEE_L, TOE_L, HIP_L),
                                   (ANK_R, KNEE_R, TOE_R, HIP_R)):
            if not att[a_i]:
                continue
            ft = self.feet[a_i]
            tx, tz = tgt[a_i]
            an = p[a_i]
            lift = 0.0
            aux = self.leg_aux.get(a_i)
            if aux is not None:
                aux[3] = 0.0 if (walk and ft[2] is not None) else \
                    (0.3 if self.crouch < 0.04 else 0.03)
            if walk and ft[2] is not None:
                sw = ft[2]
                sw[0] += dt / STEP_T
                s = min(1.0, sw[0])
                e = s * s * (3.0 - 2.0 * s)
                fx = sw[1] + (tx - sw[1]) * e
                fz = sw[2] + (tz - sw[2]) * e
                lift = STEP_LIFT * math.sin(math.pi * s)
                pull(an, fx, 0.075 + lift, fz, 520 * g, 32 * g, idt)
                self.bob += 0.015 * math.sin(math.pi * s)
                if s >= 1.0:
                    ft[0], ft[1], ft[2] = fx, fz, None
                    self.step_cd = 0.02
            elif walk:
                fx, fz = ft[0], ft[1]
                if self.stun == 0 and math.hypot(pel.x - fx, pel.z - fz) < 0.34:
                    self.pins[a_i] = (fx, fz)       # 摩擦で固定(体の方が足を支点に進む)
                else:
                    pull(an, fx, 0, fz, 320 * g, 30 * g, idt, ay=False)
            else:
                fx, fz = tx, tz
                pull(an, fx, 0, fz, 240 * g, 21 * g, idt, ay=False)
            hp_ = p[h_i]
            kx = (fx + hp_.x) * 0.5 + F[0] * 0.10
            kz = (fz + hp_.z) * 0.5 + F[2] * 0.10
            if lift > 0.0:
                pull(p[k_i], kx + F[0] * 0.06, 0.52 + lift * 0.8, kz + F[2] * 0.06,
                     140 * g, 12 * g, idt)
            else:
                pull(p[k_i], kx, 0, kz, 100 * g, 10 * g, idt, ay=False)
            if att[t_i]:
                pull(p[t_i], an.x + F[0] * 0.15, 0.03 + lift * 0.6,
                     an.z + F[2] * 0.15, 90 * g, 9 * g, idt)

    def sword_control(self, dt, idt, F, R):
        p, att = self.pt, self.att
        ch = p[CHEST]
        hands = [h for h in (HAND_R, HAND_L) if att[h] and h in self.grip_hands]
        if not self.armed or not hands:
            for h in (HAND_L, HAND_R):
                if att[h]:
                    pull(p[h], ch.x + F[0] * 0.10, ch.y - 0.38,
                         ch.z + F[2] * 0.10, 40, 6, idt)
            return
        goal = self.sword_goal()
        if goal is None:
            goal = self.guard_tip()
        d = sub(goal, self.T)
        l = length(d)
        mx = ARM_V * dt
        T = add(self.T, mul(d, mx / l)) if l > mx else goal
        G, T = self.solve_grip(T)
        self.T = T
        bd = norm(sub(T, G))
        k = 0.45 if self.stun > 0 else 1.0
        pull_rel(p[TIP], ch, T, 650 * k, 30, idt, 0.20)
        pull_rel(p[GRIP], ch, G, 520 * k, 28, idt, 0.30)
        for h, off in ((HAND_R, 0.035), (HAND_L, 0.13)):
            if h in hands:
                pull_rel(p[h], ch, sub(G, mul(bd, off)), 380 * k, 26, idt, 0.30)
        for s_i, e_i, h_i, sg in ((SHO_L, ELB_L, HAND_L, -1.0),
                                  (SHO_R, ELB_R, HAND_R, 1.0)):
            if att[s_i] and att[e_i] and att[h_i]:
                s, h = p[s_i], p[h_i]
                pull(p[e_i],
                     (s.x + h.x) * 0.5 + R[0] * 0.05 * sg - F[0] * 0.03,
                     (s.y + h.y) * 0.5 - 0.07,
                     (s.z + h.z) * 0.5 + R[2] * 0.05 * sg - F[2] * 0.03,
                     80, 8, idt)

    # ---------- 毎フレーム ----------
    def timers(self, dt):
        pel = self.pt[PELVIS]
        if self.stun > 0:
            self.stun -= 1
        if self.parry_t > 0:
            self.parry_t -= 1
        if self.thrust_t > 0.0:
            self.thrust_t -= dt
        for k in list(self.hit_cd):
            self.hit_cd[k] -= 1
            if self.hit_cd[k] <= 0:
                del self.hit_cd[k]

        if self.down > 0 or self.stun > 0:
            self.anc_x, self.anc_z = pel.x, pel.z
        if self.down > 0:
            self.down -= 1
            if self.down == 0 and self.alive():
                self.getup = GETUP_F
        elif self.getup > 0:
            self.getup -= 1
        if (self.alive() and self.down == 0 and self.getup == 0
                and self.upright() < DOWN_TH):
            self.down = DOWN_F

        if self.bleed > 0.0 and not self.ko:
            self.hurt(self.bleed * dt, 0)
        self.hp_ghost += (self.hp - self.hp_ghost) * 0.08

        g, t = self.pt[GRIP], self.pt[TIP]
        bd = norm(sub(t.pos(), g.pos()))
        v = t.vel(1.0 / SDT)
        vp = sub(v, mul(bd, dot(v, bd)))
        if length(vp) > 1.5:
            self.edge = norm(lerp(self.edge, norm(vp), 0.35))
        e = sub(self.edge, mul(bd, dot(self.edge, bd)))
        if length(e) > 1e-3:
            self.edge = norm(e)

    def hurt(self, dmg, stun):
        if self.ko:
            return
        self.hp = max(0.0, self.hp - dmg)
        if stun:
            self.stun = max(self.stun, stun)
        if self.hp <= 0.0:
            self.ko = True
            self.release_sword()
            if BLOOD:
                self.drips.append([CHEST, 2.5, 0.3, 2.2])

    def release_sword(self):
        self.bones = [b for b in self.bones if b[4] != 'grip']
        self.grip_hands = set()
        self.armed = False
        for i in (GRIP, TIP):
            self.att[i] = False

    # ---------- 血痕 ----------
    def mark_seg(self, seg, c_axis, c_blade, rel, big):
        """当たった点の体表面に血痕(部位ローカル座標で保持)"""
        if not BLOOD or seg.prof is None:
            return
        X, Y, Z = self.seg_frame(seg) or basis_y(UP)
        a, b = self.pt[seg.i], self.pt[seg.j]
        mid = lerp(a.pos(), b.pos(), 0.5)
        yl = dot(sub(c_axis, mid), Y)
        w = sub(c_blade, c_axis)
        mv = (dot(rel, X), dot(rel, Y), dot(rel, Z))
        phi = math.atan2(dot(w, Z), dot(w, X))
        n = 3 if big else 1
        for k in range(n):
            ph = phi + (k * 0.35 * (1 if mv[0] * math.sin(phi) < mv[2] * math.cos(phi) else -1))
            y = yl + mv[1] * 0.004 * k + random.uniform(-0.01, 0.01)
            u = clamp((y + seg.ys) / seg.L0 + 0.5, seg.u0, seg.u1)
            rx, rz, cx, cz = prof_eval(PROFILES[seg.prof], u)
            c, s = math.cos(ph), math.sin(ph)
            nrm = norm((c / rx, 0.0, s / rz))
            pos = (cx + rx * c + nrm[0] * 0.0025, y, cz + rz * s + nrm[2] * 0.0025)
            size = (0.055 if big else 0.032) * (1.0 - 0.3 * k) * random.uniform(0.8, 1.2)
            seg.marks.append((pos, nrm, size, random.randrange(4)))
        if len(seg.marks) > 10:
            del seg.marks[:len(seg.marks) - 10]
            seg.mrk_n = min(seg.mrk_n, 0)

    def mark_head(self, c_blade, big):
        if not BLOOD:
            return
        X, Y, Z = self.head_frame()
        v = sub(c_blade, self.pt[HEAD].pos())
        d = norm((dot(v, X), dot(v, Y), dot(v, Z)))
        if d == (0.0, 0.0, 0.0):
            return
        p = add(head_point(d), mul(d, 0.004))
        self.head_marks.append((p, d, 0.05 if big else 0.03, random.randrange(4)))

    def mark_sword(self, s):
        if BLOOD and len(self.sword_marks) < 10:
            self.sword_marks.append((BLADE * (0.12 + 0.88 * s) + random.uniform(-0.03, 0.03),
                                     random.randrange(4)))

    # ---------- 切断 ----------
    def sever(self, seg, t):
        """部位 seg を位置 t で断つ。骨を 2 本に分け、断面の点を 2 つ作る"""
        a, b = seg.i, seg.j
        pa, pb = self.pt[a], self.pt[b]
        bone = None
        for bn in self.bones:
            if bn[4] == 'struct' and ((bn[0] == a and bn[1] == b) or
                                      (bn[0] == b and bn[1] == a)):
                bone = bn
                break
        if bone is None:
            return None
        t = clamp(t, 0.18, 0.82)
        C = lerp(pa.pos(), pb.pos(), t)
        V = lerp((pa.x - pa.px, pa.y - pa.py, pa.z - pa.pz),
                 (pb.x - pb.px, pb.y - pb.py, pb.z - pb.pz), t)
        d = norm(sub(pb.pos(), pa.pos()))
        c1 = len(self.pt)
        c2 = c1 + 1
        for idx, off in ((c1, -0.006), (c2, 0.006)):
            q = Pt(add(C, mul(d, off)), 0.3, seg.r * 0.8)
            q.px, q.py, q.pz = q.x - V[0], q.y - V[1], q.z - V[2]
            self.pt.append(q)
            self.att.append(True)
        rest = bone[2]
        self.bones.remove(bone)
        self.bones.append([a, c1, rest * t, 1.0, 'struct'])
        self.bones.append([c2, b, rest * (1.0 - t), 1.0, 'struct'])

        # 見た目:元の形を t で 2 つに分け、断面を付ける。血痕も引き継ぐ
        L0 = seg.L0
        ys1 = (t * 0.5 - 0.5) * L0
        ys2 = ((1.0 + t) * 0.5 - 0.5) * L0
        s1 = self.new_seg(a, c1, seg.r, seg.mat, seg.part, False, seg.prof, L0,
                          seg.u0, t, ys1, seg.cap0, 'cut')
        s2 = self.new_seg(c2, b, seg.r, seg.mat, seg.part, False, seg.prof, L0,
                          t, seg.u1, ys2, 'cut', seg.cap1)
        for s in (s1, s2):
            s.zref = seg.zref
            s.frame = seg.frame
        ycut = (t - 0.5) * L0
        for m in seg.marks:
            pos = m[0]
            if pos[1] <= ycut:
                s1.marks.append(((pos[0], pos[1] - ys1, pos[2]),) + m[1:])
            else:
                s2.marks.append(((pos[0], pos[1] - ys2, pos[2]),) + m[1:])
        seg.dead = True
        self.segs.append(s1)
        self.segs.append(s2)
        self.lost.add(seg.part)
        if BLOOD:
            self.drips.append([c1, 6.0, 0.05, 1.2])
            self.drips.append([c2, 3.0, 0.05, 1.0])
        self.recompute()
        return C

    def recompute(self):
        """構造の骨だけで連結成分を求め、成分を跨ぐ補助・拘束を外す"""
        n = len(self.pt)
        adj = [[] for _ in range(n)]
        for a, b, rest, k, tag in self.bones:
            if tag == 'struct':
                adj[a].append(b)
                adj[b].append(a)
        comp = [-1] * n
        c = 0
        for s in range(n):
            if comp[s] >= 0:
                continue
            stack = [s]
            comp[s] = c
            while stack:
                u = stack.pop()
                for v in adj[u]:
                    if comp[v] < 0:
                        comp[v] = c
                        stack.append(v)
            c += 1
        body = comp[PELVIS]
        keep = []
        hands = set()
        for bn in self.bones:
            a, b, rest, k, tag = bn
            if tag == 'grip':
                if comp[a] == body and self.armed:
                    keep.append(bn)
                    hands.add(a)
            elif tag == 'aux':
                if comp[a] == comp[b]:
                    keep.append(bn)
            else:
                keep.append(bn)
        self.bones = keep
        self.grip_hands = hands
        if not hands:
            self.armed = False
        lim = []
        for L in self.limits:
            ids = L[1:4] if L[0] == 'knee' else L[1:3]
            if all(comp[i] == comp[ids[0]] for i in ids) and comp[ids[0]] == body:
                lim.append(L)
        self.limits = lim
        for i in range(n):
            self.att[i] = comp[i] == body or (self.armed and comp[i] == comp[GRIP])
        for i in (KNEE_L, ANK_L, KNEE_R, ANK_R):
            if comp[i] != body:
                self.crippled = True


