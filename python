# 世界
# =====================================================================
class World(object):
    MAX_GROUND = 70

    def __init__(self, stage=0):
        self.stage = stage
        self.st = STAGES[stage]
        self.round_no = 1
        self.wins = [0, 0]
        self.gen = 0
        self.gid = 0
        self.match = None           # 'win' / 'lose'(景の勝敗)
        self.stats = {'time': 0.0, 'sever': 0, 'wound': 0, 'deep': 0, 'hp': []}
        self.new_round()

    def new_round(self):
        self.player = Fighter('YOU', (-1.1, 0.0), (1.0, 0.0, 0.0), PAL_P, True)
        self.cpu = Fighter('CPU', (1.1, 0.0), (-1.0, 0.0, 0.0), self.st['pal'], False)
        self.player.foe, self.cpu.foe = self.cpu, self.player
        self.ai = AI(self.cpu, self.player, CPU_LEVEL * self.st['level'])
        self.state = 'fight'
        self.t = 0.0
        self.over_t = 0.0
        self.events = []
        self.fx = []
        self.ground = []            # (id, x, z, 大きさ, 角度, 種類)
        self.slowmo = 0.0
        self.shake = 0.0
        self.clash_cd = 0
        self.winner = None
        self.gen += 1
        self.say('%s 第 %d 番 始め' % (self.st['name'], self.round_no), 2.2,
                 (1, 0.96, 0.88))

    def say(self, text, sec, col):
        self.events.append([text, sec, col])
        if len(self.events) > 4:
            self.events.pop(0)

    def add_ground(self, x, z, size):
        self.gid += 1
        self.ground.append((self.gid, x, z, size, random.uniform(0, math.pi * 2),
                            random.randrange(4)))
        if len(self.ground) > self.MAX_GROUND:
            self.ground.pop(0)

    # ---------- 物理 ----------
    def integrate(self, f, dt):
        dt2 = dt * dt
        for q in f.pt:
            nx = q.x + (q.x - q.px) * DAMP + q.fx * q.im * dt2
            ny = q.y + (q.y - q.py) * DAMP + (q.fy * q.im + GRAV) * dt2
            nz = q.z + (q.z - q.pz) * DAMP + q.fz * q.im * dt2
            q.px, q.py, q.pz = q.x, q.y, q.z
            q.x, q.y, q.z = nx, ny, nz
            q.fx = q.fy = q.fz = 0.0

    def constrain(self, f):
        pt = f.pt
        F = f.F
        for _ in range(ITER):
            for a_i, b_i, rest, k, tag in f.bones:
                a, b = pt[a_i], pt[b_i]
                dx, dy, dz = b.x - a.x, b.y - a.y, b.z - a.z
                d = math.sqrt(dx * dx + dy * dy + dz * dz)
                if d < 1e-9:
                    continue
                w = a.im + b.im
                c = (d - rest) / (d * w) * k
                a.x += dx * c * a.im
                a.y += dy * c * a.im
                a.z += dz * c * a.im
                b.x -= dx * c * b.im
                b.y -= dy * c * b.im
                b.z -= dz * c * b.im
            for a_i, (px_, pz_) in f.pins.items():
                q = pt[a_i]
                q.x += (px_ - q.x) * 0.6
                q.z += (pz_ - q.z) * 0.6
            for L in f.limits:
                kind = L[0]
                if kind == 'knee':
                    h, kn, an, marg = pt[L[1]], pt[L[2]], pt[L[3]], L[4]
                    ux, uy, uz = an.x - h.x, an.y - h.y, an.z - h.z
                    uu = ux * ux + uy * uy + uz * uz
                    if uu < 1e-9:
                        continue
                    s = ((kn.x - h.x) * ux + (kn.y - h.y) * uy + (kn.z - h.z) * uz) / uu
                    vx = kn.x - (h.x + ux * s)
                    vz = kn.z - (h.z + uz * s)
                    fwd = vx * F[0] + vz * F[2]
                    if fwd >= marg:
                        continue
                    dlt = marg - fwd
                    tot = kn.im + 0.5 * (h.im + an.im)
                    wk = dlt * kn.im / tot
                    wo = dlt * 0.5 / tot
                    kn.x += F[0] * wk
                    kn.z += F[2] * wk
                    h.x -= F[0] * wo * h.im
                    h.z -= F[2] * wo * h.im
                    an.x -= F[0] * wo * an.im
                    an.z -= F[2] * wo * an.im
                else:
                    a, b, lim = pt[L[1]], pt[L[2]], L[3]
                    dx, dy, dz = b.x - a.x, b.y - a.y, b.z - a.z
                    d = math.sqrt(dx * dx + dy * dy + dz * dz)
                    if d < 1e-9:
                        continue
                    if kind == 'max' and d <= lim:
                        continue
                    if kind == 'min' and d >= lim:
                        continue
                    w = a.im + b.im
                    c = (d - lim) / (d * w)
                    a.x += dx * c * a.im
                    a.y += dy * c * a.im
                    a.z += dz * c * a.im
                    b.x -= dx * c * b.im
                    b.y -= dy * c * b.im
                    b.z -= dz * c * b.im
        for q in pt:
            if q.y < q.r:
                vy = q.y - q.py
                q.y = q.r
                q.py = q.y + vy * 0.1 if vy < 0 else q.py
                q.px = q.x - (q.x - q.px) * GROUND_FRIC
                q.pz = q.z - (q.z - q.pz) * GROUND_FRIC
            r = math.hypot(q.x, q.z)
            if r > ARENA_R:
                s = ARENA_R / r
                q.x *= s
                q.z *= s

    @staticmethod
    def seg_pts(f, seg, t):
        if seg.i == seg.j:
            return [(f.pt[seg.i], 1.0)]
        return [(f.pt[seg.i], 1.0 - t), (f.pt[seg.j], t)]

    def body_collide(self, A, B):
        """二人の全部位(死体・切断片を含む)をカプセル同士で押し合う"""
        def bounds(f):
            out = []
            for s in f.segs:
                if s.dead:
                    continue
                a, b = f.pt[s.i], f.pt[s.j]
                pa, pb = (a.x, a.y, a.z), (b.x, b.y, b.z)
                c = ((a.x + b.x) * 0.5, (a.y + b.y) * 0.5, (a.z + b.z) * 0.5)
                hl = math.sqrt((b.x - a.x) ** 2 + (b.y - a.y) ** 2 + (b.z - a.z) ** 2) * 0.5
                out.append((s, pa, pb, c, hl + s.r))
            return out
        la, lb = bounds(A), bounds(B)
        for sa, pa, qa, ca, ra in la:
            for sb, pb, qb, cb, rb in lb:
                dx, dy, dz = cb[0] - ca[0], cb[1] - ca[1], cb[2] - ca[2]
                lim = ra + rb
                if dx * dx + dy * dy + dz * dz > lim * lim:
                    continue
                s, u, c1, c2 = seg_seg(pa, qa, pb, qb)
                dv = sub(c2, c1)
                d = length(dv)
                R = sa.r + sb.r
                if d >= R:
                    continue
                n = norm(dv) if d > 1e-6 else (1.0, 0.0, 0.0)
                self.push_pair(n, (R - d), self.seg_pts(A, sa, s),
                               self.seg_pts(B, sb, u))

    @staticmethod
    def push_pair(n, over, pts_a, pts_b):
        wa = sum(w * w * q.im for q, w in pts_a)
        wb = sum(w * w * q.im for q, w in pts_b)
        if wa + wb <= 0.0:
            return
        lam = over / (wa + wb)
        for q, w in pts_a:
            c = lam * w * q.im
            q.x -= n[0] * c
            q.y -= n[1] * c
            q.z -= n[2] * c
        for q, w in pts_b:
            c = lam * w * q.im
            q.x += n[0] * c
            q.y += n[1] * c
            q.z += n[2] * c

    @staticmethod
    def slow_blade(ga, ta, k):
        for q in (ga, ta):
            q.px = q.x - (q.x - q.px) * k
            q.py = q.y - (q.y - q.py) * k
            q.pz = q.z - (q.z - q.pz) * k

    def blade_blade(self, A, B):
        if not (A.armed and B.armed):
            return
        ga, ta, gb, tb = A.pt[GRIP], A.pt[TIP], B.pt[GRIP], B.pt[TIP]
        s, u, c1, c2 = seg_seg(ga.pos(), ta.pos(), gb.pos(), tb.pos())
        dv = sub(c2, c1)
        d = length(dv)
        R = 0.03
        if d >= R:
            return
        n = norm(dv) if d > 1e-6 else norm(cross(sub(ta.pos(), ga.pos()), UP))
        idt = 1.0 / SDT
        va = lerp(ga.vel(idt), ta.vel(idt), s)
        vb = lerp(gb.vel(idt), tb.vel(idt), u)
        rel = length(sub(va, vb))
        self.push_pair(n, R - d, [(ga, 1 - s), (ta, s)], [(gb, 1 - u), (tb, u)])
        if rel > 2.5 and self.clash_cd <= 0:
            self.clash_cd = 8
            A.parry_t = max(A.parry_t, 10)
            B.parry_t = max(B.parry_t, 10)
            self.fx.append(('spark', lerp(c1, c2, 0.5), n))
            self.shake = max(self.shake, 0.012)

    def blade_body(self, A, D):
        if not A.armed or not A.alive():
            return
        ga, ta = A.pt[GRIP], A.pt[TIP]
        idt = 1.0 / SDT
        g0, t0 = ga.pos(), ta.pos()
        b0 = lerp(g0, t0, 0.12)
        # 接触を先に集め、細い部位(首・腕)から処理する。
        # 太い胴の判定が首や腕を覆っていても、具体的な部位が優先される
        hits = []
        for seg in D.segs:
            if seg.dead:
                continue
            pi, pj = D.pt[seg.i].pos(), D.pt[seg.j].pos()
            s, u, c1, c2 = seg_seg(b0, t0, pi, pj)
            if length(sub(c2, c1)) < seg.r + 0.012:
                hits.append(seg)
        hits.sort(key=lambda sg: sg.r)
        struck = False
        for seg in hits:
            if seg.dead:
                continue
            g0, t0 = ga.pos(), ta.pos()
            b0 = lerp(g0, t0, 0.12)
            bd = norm(sub(t0, g0))
            gv, tv = ga.vel(idt), ta.vel(idt)
            qi, qj = D.pt[seg.i], D.pt[seg.j]
            pi, pj = qi.pos(), qj.pos()
            s, u, c1, c2 = seg_seg(b0, t0, pi, pj)
            dv = sub(c2, c1)
            dist = length(dv)
            rad = seg.r + 0.012
            if dist >= rad:
                continue
            sb = 0.12 + 0.88 * s
            vb = lerp(gv, tv, sb)
            vl = lerp(qi.vel(idt), qj.vel(idt), u)
            rel = sub(vb, vl)
            ld = norm(sub(pj, pi))
            rp = sub(rel, mul(ld, dot(rel, ld)))
            cut_v = length(sub(rp, mul(bd, dot(rp, bd)))) + 0.3 * abs(dot(rel, bd))
            base = seg.part.split('_')[0]
            attached = D.att[seg.i] and D.att[seg.j]
            if not struck and A.hit_cd.get(seg.key, 0) == 0 and A.parry_t == 0:
                if seg.sever and attached and cut_v >= WOUND_V.get(base, 99.0):
                    struck = True
                    A.hit_cd[seg.key] = 24
                    D.wounds[seg.part] = D.wounds.get(seg.part, 0) + 1
                    D.mark_seg(seg, c2, c1, rel, True)
                    A.mark_sword(s)
                    if D.wounds[seg.part] >= WOUNDS_TO_SEVER:
                        C = D.sever(seg, u)
                        if C:
                            self.on_sever(A, D, seg, C, rel)
                            self.slow_blade(ga, ta, 0.55)
                            continue
                    self.on_wound(A, D, seg, c2, rel, qi, qj, u)
                    self.slow_blade(ga, ta, 0.82)   # 肉を裂いて刃は抜ける
                    continue
                if cut_v >= HIT_V:
                    struck = True
                    A.hit_cd[seg.key] = 18
                    self.on_hit(A, D, seg, base, cut_v, c1, c2, rel, qi, qj, u,
                                attached)
                    A.mark_sword(s)
            if struck and seg.r > 0.12:
                continue            # 既に斬った刃を胴の判定で押し戻さない
            # 斬れない速さなら刃は体に止められる
            n = norm(dv) if dist > 1e-6 else norm(cross(bd, UP))
            self.push_pair(n, rad - dist, [(ga, 1 - sb), (ta, sb)],
                           [(qi, 1 - u), (qj, u)])

    def knock(self, rel, qi, qj, u, k):
        k = min(1.0, 3.0 / (length(rel) + 1e-6)) * k
        for q, w in ((qi, 1 - u), (qj, u)):
            q.px -= rel[0] * k * w * SDT
            q.py -= rel[1] * k * w * SDT
            q.pz -= rel[2] * k * w * SDT

    def who(self, D):
        return '敵' if D is self.cpu else '己'

    def on_hit(self, A, D, seg, base, v, c_blade, c_axis, rel, qi, qj, u, attached):
        live = D.alive() and attached
        if base == 'head':
            D.mark_head(c_blade, v >= HEAD_V)
        else:
            D.mark_seg(seg, c_axis, c_blade, rel, v >= TORSO_V)
        self.fx.append(('hit', c_axis, norm(rel)))
        if not live:
            # 死体や切り落とされた部位:傷も体力も無く、刃に弾かれて動くだけ
            self.knock(rel, qi, qj, u, 0.7)
            return
        deep = False
        if base == 'head':
            deep = v >= HEAD_V
            dmg = 30.0 if deep else (v - HIT_V) * 6.0
            stun = 20 if deep else 8
        elif base == 'torso':
            deep = v >= TORSO_V
            dmg = 18.0 if deep else (v - HIT_V) * 4.0
            stun = 12 if deep else 5
        else:
            dmg = (v - HIT_V) * 2.5
            stun = 4
        dmg = clamp(dmg, 1.5, 40.0)
        D.hurt(dmg, stun)
        self.knock(rel, qi, qj, u, 0.25)
        self.shake = max(self.shake, 0.02 if deep else 0.008)
        if deep:
            if A.is_player:
                self.stats['deep'] += 1
            self.say('%sの%s 深手' % (self.who(D), PART_JP.get(seg.part, '')),
                     1.2, A.pal['hud'])
            if BLOOD:
                D.drips.append([seg.j if base == 'head' else CHEST, 1.5, 0.1, 0.8])

    def on_wound(self, A, D, seg, pos, rel, qi, qj, u):
        n = D.wounds[seg.part]
        neck = seg.part == 'neck'
        self.knock(rel, qi, qj, u, 0.18)
        self.fx.append(('hit', pos, norm(rel)))
        if BLOOD:
            D.drips.append([seg.i if u < 0.5 else seg.j, 1.6, 0.1, 0.7])
        if not D.alive():
            return
        D.hurt(12.0 if neck else 6.0, 8)
        D.bleed += 1.2 if neck else 0.35
        self.shake = max(self.shake, 0.012)
        if A.is_player:
            self.stats['wound'] += 1
        self.say('%sの%sに傷 %d/%d' % (self.who(D), PART_JP.get(seg.part, ''),
                                     n, WOUNDS_TO_SEVER), 1.3, A.pal['hud'])

    def on_sever(self, A, D, seg, C, rel):
        base = seg.part.split('_')[0]
        self.fx.append(('cut', C, norm(rel)))
        self.shake = max(self.shake, 0.03)
        if not D.alive():
            return
        self.slowmo = 0.6
        if A.is_player:
            self.stats['sever'] += 1
        self.say('%sの%s 両断' % (self.who(D), PART_JP.get(seg.part, '')),
                 1.8, A.pal['hud'])
        if base == 'neck':
            D.hurt(999.0, 0)
            return
        D.bleed += 9.0 if D.crippled else 2.5
        D.hurt(30.0 if base in ('thigh', 'shin') else 16.0, 18)

    # ---------- 1 フレーム ----------
    def step(self):
        P, C = self.player, self.cpu
        self.t += DT
        if self.state == 'fight':
            self.stats['time'] += DT
            self.ai.think(DT)
        else:
            self.over_t += DT
            C.mvx = C.mvz = 0.0
        for _ in range(SUB):
            P.control(C, SDT)
            C.control(P, SDT)
            self.integrate(P, SDT)
            self.integrate(C, SDT)
            self.constrain(P)
            self.constrain(C)
            self.body_collide(P, C)
            self.blade_blade(P, C)
            self.blade_body(P, C)
            self.blade_body(C, P)
        P.timers(DT)
        C.timers(DT)
        for f in (P, C):
            keep = []
            for d in f.drips:
                d[1] -= DT
                d[2] -= DT
                if d[2] <= 0.0:
                    d[2] = random.uniform(0.10, 0.28)
                    q = f.pt[d[0]]
                    if q.y < 2.0:
                        self.add_ground(q.x + random.uniform(-0.05, 0.05),
                                        q.z + random.uniform(-0.05, 0.05),
                                        random.uniform(0.03, 0.07) * d[3])
                if d[1] > 0.0:
                    keep.append(d)
            f.drips = keep
        if self.clash_cd > 0:
            self.clash_cd -= 1
        self.shake *= 0.86
        for e in self.events:
            e[1] -= DT
        self.events = [e for e in self.events if e[1] > 0]

        if self.state == 'fight':
            lose_p = not P.alive()
            lose_c = not C.alive()
            if lose_p or lose_c:
                self.state = 'over'
                self.over_t = 0.0
                if lose_c and not lose_p:
                    self.wins[0] += 1
                    self.winner = P
                    self.stats['hp'].append(P.hp)
                    self.say('一本!', 99, (1.0, 0.95, 0.8))
                elif lose_p and not lose_c:
                    self.wins[1] += 1
                    self.winner = C
                    self.say('無念...', 99, (1.0, 0.75, 0.7))
                else:
                    self.say('相討ち', 99, (1, 1, 1))
                if self.wins[0] >= WIN_ROUNDS:
                    self.match = 'win'
                elif self.wins[1] >= WIN_ROUNDS:
                    self.match = 'lose'

    def next_round(self):
        self.round_no += 1
        self.new_round()

    def redo_round(self):
        self.new_round()


